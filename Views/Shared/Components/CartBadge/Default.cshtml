@model DashboardOrders.Models.CartBadgeViewModel

<a asp-controller="Home"
   asp-action="Cart"
   class="relative inline-flex min-h-10 items-center justify-center rounded-lg border border-slate-200 bg-slate-900 px-3 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:border-slate-700 hover:bg-slate-800"
   aria-label="Carrello">
    <span class="relative mr-2 inline-flex h-5 w-6 items-center justify-center">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l2.4 12.4a2 2 0 002 1.6h7.8a2 2 0 001.9-1.4L21 8H7"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 21a1 1 0 100-2 1 1 0 000 2zm8 0a1 1 0 100-2 1 1 0 000 2z"></path>
        </svg>
        <span class="absolute -top-3 left-4 text-xs font-bold text-amber-400">@Model.ItemsCount</span>
    </span>
    <span class="hidden sm:inline">Carrello</span>
    @if (Model.HasItems)
    {
        <span class="sr-only">con @Model.ItemsCount articoli</span>
    }
</a>
