@model SortableHeaderViewModel

<a asp-action="@Model.ActionName"
   asp-controller="@Model.ControllerName"
   asp-all-route-data="@Model.RouteValues()"
   class="inline-flex items-center gap-2 text-xs uppercase tracking-wider transition-colors hover:text-indigo-600 @Model.AlignmentClass @Model.SortLabelClass">
    <span>@Model.Label</span>
    <span class="text-sm text-indigo-600">@Model.SortArrow</span>
</a>
