@model List<Metric>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    @foreach (var metric in Model)
    {
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 hover:shadow-md transition-all">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <div class="p-3 rounded-xl bg-gradient-to-r @(metric.Color)-100 to-@(metric.Color)-200">
                        <span class="text-xl"> @metric.Icon </span>
                    </div>
                    <div>
                        <p class="text-sm font-medium text-slate-500">@metric.Name</p>
                        <p class="text-2xl font-bold text-slate-800">@metric.Value</p>
                    </div>
                </div>
                <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800">
                    @metric.Trend
                </span>
            </div>
        </div>
    }
</div>