<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gestione Ordini</title>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isCustomersPage = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "Customers", StringComparison.OrdinalIgnoreCase);
    var customerSearch = CustomerSearchFormViewModel.FromViewData(ViewData, isCustomersPage);
    var navigationItems = new[]
    {
        (ActionName: "Index", Label: "Panoramica", IconPath: "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"),
        (ActionName: "Orders", Label: "Ordini", IconPath: "M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"),
        (ActionName: "Customers", Label: "Clienti", IconPath: "M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"),
        (ActionName: "Products", Label: "Prodotti", IconPath: "M20 13V7a2 2 0 00-2-2h-3V3H9v2H6a2 2 0 00-2 2v6m16 0l-2.293 2.293a1 1 0 00-.293.707V19a2 2 0 01-2 2H9a2 2 0 01-2-2v-3a1 1 0 00-.293-.707L4 13m16 0H4m5 4h6")
    };

    bool IsCurrentAction(string actionName) =>
        string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, actionName, StringComparison.OrdinalIgnoreCase);

    string SidebarLinkClass(string actionName) => IsCurrentAction(actionName)
        ? "sidebar-link flex items-center px-4 py-3 bg-indigo-600 rounded-lg text-white font-medium shadow-md shadow-indigo-600/30 transition-all"
        : "sidebar-link flex items-center px-4 py-3 text-slate-300 hover:bg-slate-800 hover:text-white rounded-lg font-medium transition-colors";

    string MobileNavLinkClass(string actionName) => IsCurrentAction(actionName)
        ? "inline-flex min-w-max items-center rounded-full bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm shadow-indigo-600/30"
        : "inline-flex min-w-max items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-600";
}
<body class="bg-slate-50 text-slate-800 h-screen flex overflow-hidden">

    <aside class="hidden w-64 shrink-0 flex-col bg-slate-900 text-white shadow-xl md:flex">
        <div class="flex h-16 items-center justify-center border-b border-slate-800">
            <h1 class="text-xl font-bold tracking-wider text-indigo-400">DASHBOARD</h1>
        </div>
        <nav class="flex-1 space-y-2 overflow-y-auto px-4 py-6" id="sidebar-nav">
            @foreach (var item in navigationItems)
            {
                <a asp-action="@item.ActionName" asp-controller="Home" class="@SidebarLinkClass(item.ActionName)">
                    <svg class="mr-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@item.IconPath"></path></svg>
                    @item.Label
                </a>
            }
        </nav>
    </aside>

    <div class="flex h-screen flex-1 flex-col overflow-hidden">
        <header class="z-10 flex h-16 shrink-0 items-center justify-between bg-white px-4 shadow-sm sm:px-6">
            <div class="flex items-center">
                <div class="relative hidden sm:block">
                    <form id="customer-search-form"
                          method="get"
                          asp-action="Customers"
                          asp-controller="Home"
                          class="relative"
                          data-search-enabled="@(customerSearch.IsEnabled ? "true" : "false")"
                          data-current-search="@customerSearch.SearchTerm">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                        </span>
                        <input id="customer-search-input"
                               type="text"
                               name="search"
                               value="@customerSearch.SearchTerm"
                               class="w-64 rounded-lg border border-slate-200 bg-slate-50 py-2 pl-10 pr-4 text-sm outline-none transition-all focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-500"
                               placeholder="Cerca..."
                               autocomplete="off">
                        <input type="hidden" name="page" value="1" />
                        <input type="hidden" name="pageSize" value="@customerSearch.PageSize" />
                        <input type="hidden" name="sortBy" value="@customerSearch.SortBy" />
                        <input type="hidden" name="sortDirection" value="@customerSearch.SortDirection" />
                    </form>
                </div>
            </div>
            <div class="flex items-center space-x-4">
                <button class="text-slate-400 transition-colors hover:text-indigo-600" aria-label="Notifiche">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
                </button>
                <div class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-full bg-gradient-to-r from-indigo-500 to-purple-500 font-bold text-white shadow-sm">
                    PA
                </div>
            </div>
        </header>

        <div class="border-b border-slate-200 bg-white px-4 py-3 md:hidden">
            <nav class="flex gap-2 overflow-x-auto pb-1" aria-label="Navigazione mobile">
                @foreach (var item in navigationItems)
                {
                    <a asp-action="@item.ActionName" asp-controller="Home" class="@MobileNavLinkClass(item.ActionName)">@item.Label</a>
                }
            </nav>
        </div>

        <main class="flex-1 overflow-x-hidden overflow-y-auto bg-slate-50 p-4 sm:p-6">
            <div class="mx-auto max-w-7xl">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
