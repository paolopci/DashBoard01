@using DashboardOrders.Models
@model PagedPageViewModel

@{
    // Calculate total items based on which model we're using
    var totalItems = Model switch
    {
        OrdersPageViewModel orders => orders.TotalOrders,
        CustomersPageViewModel customers => customers.TotalCustomers,
        ProductsPageViewModel products => products.TotalProducts,
        _ => Model.TotalPages * Model.PageSize
    };
}

<div class="bg-white px-4 py-3 flex items-center justify-between border-t border-gray-200 sm:px-6">
    <div class="flex-1 flex justify-between sm:hidden">
        <a href="?page=@(Model.CurrentPage - 1)&pageSize=@Model.PageSize"
           class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 @(Model.HasPreviousPage ? "" : "opacity-50 cursor-not-allowed")">
            Precedente
        </a>
        <a href="?page=@(Model.CurrentPage + 1)&pageSize=@Model.PageSize"
           class="ml-3 relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 @(Model.HasNextPage ? "" : "opacity-50 cursor-not-allowed")">
            Successivo
        </a>
    </div>
    <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
        <div>
            <p class="text-sm text-gray-700">
                Mostra da <span class="font-medium">@((Model.CurrentPage - 1) * Model.PageSize + 1)</span> a <span class="font-medium">@Math.Min(Model.CurrentPage * Model.PageSize, totalItems)</span>
                di <span class="font-medium">@totalItems</span> risultati
            </p>
        </div>
        <div>
            <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                <!-- First page -->
                @if (Model.TotalPages > 7)
                {
                    <a href="?page=1&pageSize=@Model.PageSize"
                       class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50 @(Model.CurrentPage == 1 ? "z-10" : "")">
                        <span class="sr-only">Prima</span>
                        &laquo;
                    </a>
                }

                <!-- Previous page -->
                <a href="?page=@(Model.CurrentPage - 1)&pageSize=@Model.PageSize"
                   class="relative inline-flex items-center px-2 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50 @(Model.HasPreviousPage ? "" : "opacity-50 cursor-not-allowed")">
                    <span class="sr-only">Precedente</span>
                    &lsaquo;
                </a>

                <!-- Page numbers -->
                @if (Model.TotalPages <= 7)
                {
                    @for (var i = 1; i <= Model.TotalPages; i++)
                    {
                        <a href="?page=@i&pageSize=@Model.PageSize"
                           class="relative inline-flex items-center px-4 py-2 border text-sm font-medium @(i == Model.CurrentPage ? "z-10 bg-indigo-50 border-indigo-500 text-indigo-600" : "bg-white border-gray-300 text-gray-500 hover:bg-gray-50")">
                            @i
                        </a>
                    }
                }
                else
                {
                    <!-- Show first page, current page, and last page -->
                    @if (Model.CurrentPage > 3)
                    {
                        <a href="?page=1&pageSize=@Model.PageSize"
                           class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
                            1
                        </a>
                        @if (Model.CurrentPage > 4)
                        {
                            <span class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-700">
                                ...
                            </span>
                        }
                    }

                    <!-- Current page and neighbors -->
                    @for (var i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                    {
                        <a href="?page=@i&pageSize=@Model.PageSize"
                           class="relative inline-flex items-center px-4 py-2 border text-sm font-medium @(i == Model.CurrentPage ? "z-10 bg-indigo-50 border-indigo-500 text-indigo-600" : "bg-white border-gray-300 text-gray-500 hover:bg-gray-50")">
                            @i
                        </a>
                    }

                    @if (Model.CurrentPage < Model.TotalPages - 2)
                    {
                        @if (Model.CurrentPage < Model.TotalPages - 3)
                        {
                            <span class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-700">
                                ...
                            </span>
                        }
                        <a href="?page=@Model.TotalPages&pageSize=@Model.PageSize"
                           class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
                            @Model.TotalPages
                        </a>
                    }
                }

                <!-- Next page -->
                <a href="?page=@(Model.CurrentPage + 1)&pageSize=@Model.PageSize"
                   class="relative inline-flex items-center px-2 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50 @(Model.HasNextPage ? "" : "opacity-50 cursor-not-allowed")">
                    <span class="sr-only">Successivo</span>
                    &rsaquo;
                </a>

                <!-- Last page -->
                @if (Model.TotalPages > 7)
                {
                    <a href="?page=@Model.TotalPages&pageSize=@Model.PageSize"
                       class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50 @(Model.CurrentPage == Model.TotalPages ? "z-10" : "")">
                        <span class="sr-only">Ultima</span>
                        &raquo;
                    </a>
                }
            </nav>
        </div>
        <div class="flex items-center space-x-2">
            <label for="pageSize" class="text-sm font-medium text-gray-700">Elementi per pagina:</label>
            <select id="pageSize" name="pageSize"
                    class="block w-20 pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md"
                    onchange="changePageSize(this.value)">
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
    </div>
</div>

<script>
function changePageSize(pageSize) {
    const url = new URL(window.location);
    url.searchParams.set('pageSize', pageSize);
    url.searchParams.set('page', 1); // Reset to first page when changing page size
    window.location.href = url.toString();
}
</script>