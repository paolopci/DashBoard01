@model List<TrendData>

<canvas id="orderTrendChart" height="100"></canvas>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
const ctx = document.getElementById('orderTrendChart').getContext('2d');
const chart = new Chart(ctx, {
    type: 'line',
    data: {
        labels: [@Html.Raw(string.Join(",", Model.Select(t => $"'{t.Label}'")))],
        datasets: [{
            label: 'Ordini Giornalieri',
            data: [@Html.Raw(string.Join(",", Model.Select(t => t.Value)))],
            borderColor: 'rgb(99, 102, 241)',
            backgroundColor: 'rgba(99, 102, 241, 0.1)',
            tension: 0.4
        }]
    },
    options: {
        responsive: true,
        scales: {
            y: { beginAtZero: true }
        }
    }
});
</script>