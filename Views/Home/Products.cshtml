@using System.Globalization
@model DashboardOrders.Models.ProductsPageViewModel
@{
    ViewData["Title"] = "Prodotti";
    var italianCulture = CultureInfo.GetCultureInfo("it-IT");
    var currentSortBy = Model.SortBy;
    var currentSortDirection = Model.SortDirection;
    var visiblePages = new List<int>();

    string FormatEuro(decimal value, string numericFormat = "N2")
    {
        return $"{value.ToString(numericFormat, italianCulture)} €";
    }

    string GetNextSortDirection(string column)
    {
        return currentSortBy == column && currentSortDirection == "asc" ? "desc" : "asc";
    }

    string GetSortArrow(string column)
    {
        if (currentSortBy != column)
        {
            return "↑↓";
        }

        return currentSortDirection == "asc" ? "↑" : "↓";
    }

    string GetSortLabelClass(string column)
    {
        return currentSortBy == column
            ? "font-bold text-slate-800"
            : "font-semibold text-slate-500";
    }

    if (!Model.ShowAll)
    {
        visiblePages.Add(1);

        for (var pageNumber = Math.Max(2, Model.CurrentPage - 1); pageNumber <= Math.Min(Model.TotalPages - 1, Model.CurrentPage + 1); pageNumber++)
        {
            if (!visiblePages.Contains(pageNumber))
            {
                visiblePages.Add(pageNumber);
            }
        }

        if (Model.TotalPages > 1 && !visiblePages.Contains(Model.TotalPages))
        {
            visiblePages.Add(Model.TotalPages);
        }

        visiblePages = visiblePages
            .Where(pageNumber => pageNumber >= 1 && pageNumber <= Model.TotalPages)
            .Distinct()
            .OrderBy(pageNumber => pageNumber)
            .ToList();
    }
}

<div class="mb-8">
    <h2 class="text-2xl font-bold text-slate-800">Prodotti</h2>
    <p class="mt-1 text-slate-500">Catalogo completo con 200 prodotti, categorie dedicate, disponibilita di magazzino e costi unitari coerenti con gli ordini esistenti.</p>
</div>

<div class="mb-8 grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-4">
    <div class="flex items-center space-x-4 rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
        <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-indigo-100">
            <svg class="h-7 w-7 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V7a2 2 0 00-2-2h-3V3H9v2H6a2 2 0 00-2 2v6m16 0l-2.293 2.293a1 1 0 00-.293.707V19a2 2 0 01-2 2H9a2 2 0 01-2-2v-3a1 1 0 00-.293-.707L4 13m16 0H4"></path></svg>
        </div>
        <div>
            <p class="text-sm font-medium text-slate-500">Prodotti Totali</p>
            <p class="text-3xl font-bold text-slate-800">@Model.TotalProducts</p>
        </div>
    </div>

    <div class="flex items-center space-x-4 rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
        <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-emerald-100">
            <svg class="h-7 w-7 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h10M7 12h6m-6 5h10M5 3h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2z"></path></svg>
        </div>
        <div>
            <p class="text-sm font-medium text-slate-500">Categorie</p>
            <p class="text-3xl font-bold text-slate-800">@Model.TotalCategories</p>
        </div>
    </div>

    <div class="flex items-center space-x-4 rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
        <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-amber-100">
            <svg class="h-7 w-7 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
        </div>
        <div>
            <p class="text-sm font-medium text-slate-500">Stock Totale</p>
            <p class="text-3xl font-bold text-slate-800">@Model.TotalStock</p>
        </div>
    </div>

    <div class="flex items-center space-x-4 rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
        <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-purple-100">
            <span class="text-3xl font-bold leading-none text-purple-600">€</span>
        </div>
        <div>
            <p class="text-sm font-medium text-slate-500">Valore Magazzino</p>
            <p class="text-3xl font-bold text-slate-800">@FormatEuro(Model.InventoryValue, "N0")</p>
        </div>
    </div>
</div>

<div class="overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm">
    <div class="flex items-center justify-between border-b border-slate-100 px-6 py-5">
        <h3 class="text-lg font-semibold text-slate-800">Elenco Prodotti</h3>
        <span class="text-sm text-slate-500">Totale: @Model.TotalProducts prodotti</span>
    </div>
    <div class="flex flex-col gap-3 border-b border-slate-100 bg-slate-50/70 px-6 py-4 sm:flex-row sm:items-center sm:justify-between">
        <form method="get" asp-action="Products" asp-controller="Home" class="flex flex-col gap-3 sm:flex-row sm:items-center">
            <div class="flex items-center gap-3">
                <label for="categoryCode" class="text-sm font-medium text-slate-600">Categoria</label>
                <select id="categoryCode"
                        name="categoryCode"
                        onchange="this.form.submit()"
                        class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200">
                    @if (string.IsNullOrEmpty(Model.SelectedCategoryCode))
                    {
                        <option value="" selected>Tutti i prodotti</option>
                    }
                    else
                    {
                        <option value="">Tutti i prodotti</option>
                    }

                    @foreach (var category in Model.Categories)
                    {
                        if (category.Code == Model.SelectedCategoryCode)
                        {
                            <option value="@category.Code" selected>@category.Name</option>
                        }
                        else
                        {
                            <option value="@category.Code">@category.Name</option>
                        }
                    }
                </select>
            </div>

            <div class="flex items-center gap-3">
                <label for="pageSize" class="text-sm font-medium text-slate-600">Elementi per pagina</label>
            <select id="pageSize"
                    name="pageSize"
                    onchange="this.form.submit()"
                    class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200">
                @if (Model.PageSize == 10)
                {
                    <option value="10" selected>10</option>
                }
                else
                {
                    <option value="10">10</option>
                }

                @if (Model.PageSize == 20)
                {
                    <option value="20" selected>20</option>
                }
                else
                {
                    <option value="20">20</option>
                }

                @if (Model.PageSize == 50)
                {
                    <option value="50" selected>50</option>
                }
                else
                {
                    <option value="50">50</option>
                }

                @if (Model.ShowAll)
                {
                    <option value="0" selected>All</option>
                }
                else
                {
                    <option value="0">All</option>
                }
            </select>
            </div>
            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="sortBy" value="@Model.SortBy" />
            <input type="hidden" name="sortDirection" value="@Model.SortDirection" />
        </form>

        <div class="text-sm text-slate-500">
            @if (Model.ShowAll)
            {
                <span>Tutti i prodotti in una sola pagina</span>
            }
            else
            {
                <span>Pagina @Model.CurrentPage di @Model.TotalPages</span>
            }
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full min-w-[1100px]">
            <thead>
                <tr class="border-b border-slate-100 bg-slate-50">
                    <th class="px-6 py-4 text-left">
                        <a asp-action="Products" asp-controller="Home" asp-route-page="1" asp-route-pageSize="@Model.PageSize" asp-route-sortBy="code" asp-route-sortDirection="@GetNextSortDirection("code")" asp-route-categoryCode="@Model.SelectedCategoryCode" class="inline-flex items-center gap-2 text-xs uppercase tracking-wider transition-colors hover:text-indigo-600 @GetSortLabelClass("code")">
                            <span>Codice Prodotto</span>
                            <span class="text-sm text-indigo-600">@GetSortArrow("code")</span>
                        </a>
                    </th>
                    <th class="px-6 py-4 text-left">
                        <a asp-action="Products" asp-controller="Home" asp-route-page="1" asp-route-pageSize="@Model.PageSize" asp-route-sortBy="name" asp-route-sortDirection="@GetNextSortDirection("name")" asp-route-categoryCode="@Model.SelectedCategoryCode" class="inline-flex items-center gap-2 text-xs uppercase tracking-wider transition-colors hover:text-indigo-600 @GetSortLabelClass("name")">
                            <span>Nome Prodotto</span>
                            <span class="text-sm text-indigo-600">@GetSortArrow("name")</span>
                        </a>
                    </th>
                    <th class="px-6 py-4 text-left">
                        <a asp-action="Products" asp-controller="Home" asp-route-page="1" asp-route-pageSize="@Model.PageSize" asp-route-sortBy="category" asp-route-sortDirection="@GetNextSortDirection("category")" asp-route-categoryCode="@Model.SelectedCategoryCode" class="inline-flex items-center gap-2 text-xs uppercase tracking-wider transition-colors hover:text-indigo-600 @GetSortLabelClass("category")">
                            <span>Categoria</span>
                            <span class="text-sm text-indigo-600">@GetSortArrow("category")</span>
                        </a>
                    </th>
                    <th class="px-6 py-4 text-left">
                        <a asp-action="Products" asp-controller="Home" asp-route-page="1" asp-route-pageSize="@Model.PageSize" asp-route-sortBy="description" asp-route-sortDirection="@GetNextSortDirection("description")" asp-route-categoryCode="@Model.SelectedCategoryCode" class="inline-flex items-center gap-2 text-xs uppercase tracking-wider transition-colors hover:text-indigo-600 @GetSortLabelClass("description")">
                            <span>Descrizione</span>
                            <span class="text-sm text-indigo-600">@GetSortArrow("description")</span>
                        </a>
                    </th>
                    <th class="px-6 py-4 text-right">
                        <a asp-action="Products" asp-controller="Home" asp-route-page="1" asp-route-pageSize="@Model.PageSize" asp-route-sortBy="unitCost" asp-route-sortDirection="@GetNextSortDirection("unitCost")" asp-route-categoryCode="@Model.SelectedCategoryCode" class="inline-flex items-center justify-end gap-2 text-xs uppercase tracking-wider transition-colors hover:text-indigo-600 @GetSortLabelClass("unitCost")">
                            <span>Costo Unitario</span>
                            <span class="text-sm text-indigo-600">@GetSortArrow("unitCost")</span>
                        </a>
                    </th>
                    <th class="px-6 py-4 text-right">
                        <a asp-action="Products" asp-controller="Home" asp-route-page="1" asp-route-pageSize="@Model.PageSize" asp-route-sortBy="stock" asp-route-sortDirection="@GetNextSortDirection("stock")" asp-route-categoryCode="@Model.SelectedCategoryCode" class="inline-flex items-center justify-end gap-2 text-xs uppercase tracking-wider transition-colors hover:text-indigo-600 @GetSortLabelClass("stock")">
                            <span>Stock</span>
                            <span class="text-sm text-indigo-600">@GetSortArrow("stock")</span>
                        </a>
                    </th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50">
                @foreach (var product in Model.Products)
                {
                    <tr class="transition-colors hover:bg-slate-50">
                        <td class="px-6 py-4">
                            <div>
                                <p class="text-sm font-semibold text-indigo-600">@product.Code</p>
                                <p class="text-xs text-slate-400">@product.Category.Code</p>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-sm font-medium text-slate-800">@product.Name</td>
                        <td class="px-6 py-4">
                            <div>
                                <p class="text-sm font-semibold text-slate-700">@product.Category.Name</p>
                                <p class="text-xs text-slate-400">@product.Category.Description</p>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-sm text-slate-600">@product.Description</td>
                        <td class="px-6 py-4 text-right text-sm font-semibold text-slate-800">@FormatEuro(product.UnitCost)</td>
                        <td class="px-6 py-4 text-right">
                            <span class="inline-flex min-w-16 items-center justify-center rounded-full bg-emerald-50 px-3 py-1 text-sm font-semibold text-emerald-700">
                                @product.Stock
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="flex flex-col gap-4 border-t border-slate-100 bg-white px-6 py-4">
        <div class="text-sm text-slate-500">
            @if (Model.ShowAll)
            {
                <span>Visualizzati @Model.TotalProducts di @Model.TotalProducts prodotti</span>
            }
            else
            {
                <span>Visualizzati @Model.Products.Count prodotti su @Model.TotalProducts</span>
            }
        </div>

        @if (!Model.ShowAll)
        {
            <div class="w-full rounded-2xl border border-slate-200 bg-slate-50/80 px-4 py-3 shadow-sm">
                <div class="grid gap-4 lg:grid-cols-[1fr_auto_1fr] lg:items-center">
                    <div class="hidden lg:block"></div>

                    <nav class="flex flex-wrap items-center justify-center gap-3" aria-label="Paginazione prodotti">
                        <a asp-action="Products"
                           asp-controller="Home"
                           asp-route-page="1"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-sortBy="@Model.SortBy"
                           asp-route-sortDirection="@Model.SortDirection"
                           asp-route-categoryCode="@Model.SelectedCategoryCode"
                           class="inline-flex h-11 min-w-11 items-center justify-center rounded-xl border bg-white px-4 text-base font-semibold shadow-sm transition-colors @(Model.HasPreviousPage ? "border-slate-200 text-slate-600 hover:border-indigo-200 hover:text-indigo-600" : "border-slate-100 text-slate-300 pointer-events-none")">
                            &lt;&lt;
                        </a>
                        <a asp-action="Products"
                           asp-controller="Home"
                           asp-route-page="@Model.PreviousPage"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-sortBy="@Model.SortBy"
                           asp-route-sortDirection="@Model.SortDirection"
                           asp-route-categoryCode="@Model.SelectedCategoryCode"
                           class="inline-flex h-11 min-w-11 items-center justify-center rounded-xl border bg-white px-4 text-base font-semibold shadow-sm transition-colors @(Model.HasPreviousPage ? "border-slate-200 text-slate-600 hover:border-indigo-200 hover:text-indigo-600" : "border-slate-100 text-slate-300 pointer-events-none")">
                            &lt;
                        </a>

                        @{
                            int? previousRenderedPage = null;
                        }

                        @foreach (var pageNumber in visiblePages)
                        {
                            if (previousRenderedPage.HasValue && pageNumber - previousRenderedPage.Value > 1)
                            {
                                <span class="inline-flex h-11 min-w-11 items-center justify-center px-2 text-base font-semibold text-slate-400">...</span>
                            }

                            if (pageNumber == Model.CurrentPage)
                            {
                                <span class="inline-flex h-11 min-w-11 items-center justify-center rounded-xl bg-indigo-500 px-4 text-base font-semibold text-white shadow-md shadow-indigo-500/30">
                                    @pageNumber
                                </span>
                            }
                            else
                            {
                                <a asp-action="Products"
                                   asp-controller="Home"
                                   asp-route-page="@pageNumber"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-sortBy="@Model.SortBy"
                                   asp-route-sortDirection="@Model.SortDirection"
                                   asp-route-categoryCode="@Model.SelectedCategoryCode"
                                   class="inline-flex h-11 min-w-11 items-center justify-center rounded-xl border border-slate-200 bg-white px-4 text-base font-semibold text-slate-600 shadow-sm transition-colors hover:border-indigo-200 hover:text-indigo-600">
                                    @pageNumber
                                </a>
                            }

                            previousRenderedPage = pageNumber;
                        }

                        <a asp-action="Products"
                           asp-controller="Home"
                           asp-route-page="@Model.NextPage"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-sortBy="@Model.SortBy"
                           asp-route-sortDirection="@Model.SortDirection"
                           asp-route-categoryCode="@Model.SelectedCategoryCode"
                           class="inline-flex h-11 min-w-11 items-center justify-center rounded-xl border bg-white px-4 text-base font-semibold shadow-sm transition-colors @(Model.HasNextPage ? "border-slate-200 text-slate-600 hover:border-indigo-200 hover:text-indigo-600" : "border-slate-100 text-slate-300 pointer-events-none")">
                            &gt;
                        </a>
                        <a asp-action="Products"
                           asp-controller="Home"
                           asp-route-page="@Model.TotalPages"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-sortBy="@Model.SortBy"
                           asp-route-sortDirection="@Model.SortDirection"
                           asp-route-categoryCode="@Model.SelectedCategoryCode"
                           class="inline-flex h-11 min-w-11 items-center justify-center rounded-xl border bg-white px-4 text-base font-semibold shadow-sm transition-colors @(Model.HasNextPage ? "border-slate-200 text-slate-600 hover:border-indigo-200 hover:text-indigo-600" : "border-slate-100 text-slate-300 pointer-events-none")">
                            &gt;&gt;
                        </a>
                    </nav>

                    <div class="flex items-center justify-center gap-3 text-sm text-slate-500 lg:justify-end">
                        <span class="text-lg font-medium text-slate-600">Page</span>
                        <form method="get" asp-action="Products" asp-controller="Home" class="flex items-center gap-2">
                            <input type="hidden" name="categoryCode" value="@Model.SelectedCategoryCode" />
                            <input type="hidden" name="pageSize" value="@Model.PageSize" />
                            <input type="hidden" name="sortBy" value="@Model.SortBy" />
                            <input type="hidden" name="sortDirection" value="@Model.SortDirection" />
                            <select id="page"
                                    name="page"
                                    onchange="this.form.submit()"
                                    class="h-11 min-w-20 rounded-xl border border-slate-200 bg-white px-4 text-base font-semibold text-slate-700 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200">
                                @for (var pageNumberOption = 1; pageNumberOption <= Model.TotalPages; pageNumberOption++)
                                {
                                    if (pageNumberOption == Model.CurrentPage)
                                    {
                                        <option value="@pageNumberOption" selected>@pageNumberOption</option>
                                    }
                                    else
                                    {
                                        <option value="@pageNumberOption">@pageNumberOption</option>
                                    }
                                }
                            </select>
                        </form>
                        <span class="text-lg">of @Model.TotalPages</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
