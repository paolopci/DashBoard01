@model DashboardOrders.Models.ViewModels.CheckoutSessionViewModel
@{
    ViewData["Title"] = "Riepilogo checkout";
}

<div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <h2 class="text-3xl font-bold text-slate-900">Riepilogo checkout</h2>
        <p class="mt-1 text-sm text-slate-500">Controlla articoli e totale prima di inserire spedizione e fatturazione.</p>
    </div>
    <a asp-controller="Home" asp-action="Cart" class="text-sm font-semibold text-indigo-700 hover:text-indigo-900">Torna al carrello</a>
</div>

<div class="grid grid-cols-1 gap-5 lg:grid-cols-[minmax(0,1fr)_320px]">
    <section class="rounded-2xl border border-slate-100 bg-white shadow-sm">
        <div class="border-b border-slate-100 px-5 py-4">
            <h3 class="text-lg font-semibold text-slate-900">Articoli</h3>
        </div>
        <div class="divide-y divide-slate-100">
            @foreach (var item in Model.Cart.Items)
            {
                <div class="flex flex-col gap-3 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                        <p class="font-semibold text-slate-900">@item.ProductName</p>
                        <p class="text-sm text-slate-500">Qtà @item.Quantity x @FormatEuro(item.UnitPrice)</p>
                    </div>
                    <p class="font-bold text-slate-900">@FormatEuro(item.LineTotal)</p>
                </div>
            }
        </div>
    </section>

    <aside class="h-max rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
        <p class="text-sm font-semibold text-slate-500">Totale articoli</p>
        <p class="mt-1 text-2xl font-bold text-slate-900">@Model.Cart.TotalItems</p>
        <p class="mt-5 text-sm font-semibold text-slate-500">Totale prodotti</p>
        <p class="mt-1 text-2xl font-bold text-slate-900">@FormatEuro(Model.Cart.TotalAmount)</p>
        <a asp-controller="Home"
           asp-action="CheckoutAddresses"
           class="mt-6 inline-flex w-full items-center justify-center rounded-full bg-amber-400 px-5 py-3 text-sm font-bold text-slate-950 transition-colors hover:bg-amber-500">
            Continua
        </a>
    </aside>
</div>
