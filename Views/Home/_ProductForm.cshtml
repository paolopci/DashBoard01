@model DashboardOrders.Models.ProductFormViewModel
@{
    var isEdit = string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "EditProduct", StringComparison.OrdinalIgnoreCase);
    var actionName = isEdit ? "EditProduct" : "CreateProduct";
}

<form method="post" asp-controller="Home" asp-action="@actionName" class="overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="px-6 pt-5 text-sm font-semibold text-rose-600"></div>

    <div class="grid grid-cols-1 gap-5 px-6 py-6 md:grid-cols-2">
        <div>
            <label asp-for="Code" class="mb-2 block text-sm font-semibold text-slate-700">Codice prodotto</label>
            <input asp-for="Code" readonly="@isEdit" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 @(isEdit ? "bg-slate-100" : string.Empty)" />
            <span asp-validation-for="Code" class="mt-1 block text-xs font-semibold text-rose-600"></span>
        </div>
        <div>
            <label asp-for="Name" class="mb-2 block text-sm font-semibold text-slate-700">Nome prodotto</label>
            <input asp-for="Name" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" />
            <span asp-validation-for="Name" class="mt-1 block text-xs font-semibold text-rose-600"></span>
        </div>
        <div>
            <label asp-for="CategoryCode" class="mb-2 block text-sm font-semibold text-slate-700">Categoria</label>
            <select asp-for="CategoryCode" class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200">
                <option value="">Seleziona categoria</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Code">@category.Name</option>
                }
            </select>
            <span asp-validation-for="CategoryCode" class="mt-1 block text-xs font-semibold text-rose-600"></span>
        </div>
        <div>
            <label asp-for="UnitCost" class="mb-2 block text-sm font-semibold text-slate-700">Costo unitario</label>
            <input asp-for="UnitCost" type="number" min="0.01" step="0.01" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" />
            <span asp-validation-for="UnitCost" class="mt-1 block text-xs font-semibold text-rose-600"></span>
        </div>
        <div>
            <label asp-for="Stock" class="mb-2 block text-sm font-semibold text-slate-700">Stock</label>
            <input asp-for="Stock" type="number" min="0" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" />
            <span asp-validation-for="Stock" class="mt-1 block text-xs font-semibold text-rose-600"></span>
            @if (isEdit)
            {
                <p class="mt-1 text-xs font-medium text-slate-500">Per non vendere piu il prodotto imposta lo stock a 0.</p>
            }
        </div>
        <div class="md:col-span-2">
            <label asp-for="Description" class="mb-2 block text-sm font-semibold text-slate-700">Descrizione</label>
            <textarea asp-for="Description" rows="4" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200"></textarea>
            <span asp-validation-for="Description" class="mt-1 block text-xs font-semibold text-rose-600"></span>
        </div>
    </div>

    <div class="flex flex-col gap-3 border-t border-slate-100 px-6 py-5 sm:flex-row sm:justify-end">
        <a asp-controller="Home" asp-action="Products" class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-600 transition-colors hover:border-slate-300">
            Annulla
        </a>
        <button type="submit" class="inline-flex items-center justify-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm shadow-indigo-600/20 transition-colors hover:bg-indigo-700">
            Salva prodotto
        </button>
    </div>
</form>
