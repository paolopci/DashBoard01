@model DashboardOrders.Models.ViewModels.OrderDetailsViewModel
@{
    ViewData["Title"] = "Pagamento test";
    var checkoutDetails = Model.CheckoutDetails;
    var paymentMethod = checkoutDetails?.PaymentMethod ?? string.Empty;
    var isStripeTest = string.Equals(paymentMethod, "stripe-test", StringComparison.OrdinalIgnoreCase);
    var isInternalTestCard = string.Equals(paymentMethod, "test-card", StringComparison.OrdinalIgnoreCase);
}

<div class="mx-auto max-w-3xl rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
    <h2 class="text-3xl font-bold text-slate-900">Pagamento test</h2>
    <p class="mt-2 text-sm text-slate-500">
        @(isStripeTest ? "Pagamento Stripe in modalita test. Usa solo carte test Stripe." : "Simulatore senza addebiti reali. Non inserire dati carta.")
    </p>
    <div class="mt-6 rounded-xl bg-slate-50 p-4">
        <p class="text-sm text-slate-500">Ordine</p>
        <p class="font-semibold text-slate-900">@Model.Order.OrderNumber - @FormatEuro(Model.Order.TotalAmount)</p>
        @if (checkoutDetails is not null)
        {
            <p class="mt-2 text-sm text-slate-500">Stato pagamento: @checkoutDetails.PaymentStatus</p>
        }
    </div>

    @if (isInternalTestCard)
    {
        <form method="post" asp-controller="Home" asp-action="CheckoutPayment" class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="orderId" value="@Model.Order.Id" />
            <button name="outcome" value="@TestPaymentOutcome.Authorized" class="rounded-lg bg-emerald-600 px-4 py-3 text-sm font-semibold text-white">Pagamento riuscito</button>
            <button name="outcome" value="@TestPaymentOutcome.Failed" class="rounded-lg bg-rose-600 px-4 py-3 text-sm font-semibold text-white">Pagamento fallito</button>
            <button name="outcome" value="@TestPaymentOutcome.Pending" class="rounded-lg border border-slate-200 px-4 py-3 text-sm font-semibold text-slate-700">Lascia pending</button>
        </form>
    }
    else if (isStripeTest)
    {
        <div class="mt-6 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
            <p class="font-semibold">Pagamento Stripe test in attesa</p>
            <p class="mt-1">Se hai chiuso la pagina Stripe, torna al carrello e ripeti il checkout oppure attendi la riconciliazione del webhook.</p>
        </div>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a asp-controller="Home" asp-action="CheckoutResult" asp-route-orderId="@Model.Order.Id" class="inline-flex items-center justify-center rounded-lg bg-indigo-600 px-5 py-2 text-sm font-semibold text-white">Vedi esito ordine</a>
            <a asp-controller="Home" asp-action="Orders" class="inline-flex items-center justify-center rounded-lg border border-slate-200 px-5 py-2 text-sm font-semibold text-slate-700">Elenco ordini</a>
        </div>
    }
    else
    {
        <div class="mt-6 rounded-xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-600">
            Nessun pagamento online richiesto per questo ordine.
        </div>
    }
</div>
