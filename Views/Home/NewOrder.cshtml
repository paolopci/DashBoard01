@using System.Text.Json
@model DashboardOrders.Models.NewOrderViewModel
@{
    ViewData["Title"] = "Nuovo ordine";
    var canEditItems = User.IsInRole("Admin");
    var productCatalog = Model.Products.Select(product => new
    {
        code = product.Code,
        name = product.Name,
        description = product.Description,
        imageUrl = product.ImageUrl,
        unitCost = product.UnitCost,
        stock = product.Stock,
        categoryCode = product.Category.Code,
        categoryName = product.Category.Name
    });
    var initialItems = Model.Items.Select(item => new
    {
        productCode = item.ProductCode,
        quantity = item.Quantity
    });
}

<div class="mb-8">
    <h2 class="text-2xl font-bold text-slate-800">Nuovo ordine</h2>
    <p class="mt-1 text-slate-500">Seleziona categoria, prodotto e quantita per comporre l'ordine.</p>
</div>

<form method="post" asp-controller="Home" asp-action="NewOrder" data-new-order-form class="overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm">
    @Html.AntiForgeryToken()
    <div class="border-b border-slate-100 px-6 py-5">
        <h3 class="text-lg font-semibold text-slate-800">Dettaglio ordine</h3>
    </div>

    <div asp-validation-summary="ModelOnly" class="px-6 pt-5 text-sm font-semibold text-rose-600"></div>

    <div class="grid grid-cols-1 gap-6 px-6 py-6 lg:grid-cols-[minmax(0,1fr)_220px]">
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            <div>
                <label for="SelectedProductName" class="mb-2 block text-sm font-semibold text-slate-700">Articolo</label>
                <input id="SelectedProductName" type="text" readonly class="w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-medium text-slate-700" />
            </div>
            <div>
                <label for="SelectedProductPrice" class="mb-2 block text-sm font-semibold text-slate-700">Prezzo</label>
                <input id="SelectedProductPrice" type="text" readonly class="w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-medium text-slate-700" />
            </div>
            <div class="md:col-span-2">
                <label for="SelectedProductDescription" class="mb-2 block text-sm font-semibold text-slate-700">Descrizione</label>
                <textarea id="SelectedProductDescription" rows="3" readonly class="w-full resize-none rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700"></textarea>
            </div>
        </div>

        <div class="flex min-h-[180px] items-center justify-center rounded-xl border border-slate-200 bg-slate-50 p-3">
            <img id="SelectedProductImage" alt="" class="hidden h-40 w-full rounded-lg object-cover" />
            <span id="SelectedProductImageFallback" class="text-center text-sm font-semibold text-slate-400">Image Product</span>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-5 px-6 pb-6 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_160px_auto] md:items-end">
        <div>
            <label for="CategoryCode" class="mb-2 block text-sm font-semibold text-slate-700">Category</label>
            <select id="CategoryCode" data-category-select class="w-full rounded-lg border border-amber-500 bg-white px-3 py-2 text-sm text-slate-700 focus:border-amber-600 focus:outline-none focus:ring-2 focus:ring-amber-200">
                <option value="">Seleziona categoria</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Code">@category.Name</option>
                }
            </select>
        </div>
        <div>
            <label for="ProductCode" class="mb-2 block text-sm font-semibold text-slate-700">Products</label>
            <select id="ProductCode" data-product-select disabled class="w-full rounded-lg border border-amber-500 bg-white px-3 py-2 text-sm text-slate-700 focus:border-amber-600 focus:outline-none focus:ring-2 focus:ring-amber-200 disabled:bg-slate-100 disabled:text-slate-400">
                <option value="">Seleziona articolo</option>
            </select>
        </div>
        <div>
            <label for="Quantity" class="mb-2 block text-sm font-semibold text-slate-700">Quantita</label>
            <input id="Quantity" data-quantity-input type="number" min="1" step="1" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" />
        </div>
        <div class="flex flex-col gap-3 sm:flex-row md:flex-col xl:flex-row">
            <button type="button" data-clear-selection class="inline-flex items-center justify-center rounded-lg border border-rose-300 bg-white px-4 py-2 text-sm font-semibold text-rose-600 transition-colors hover:border-rose-400 hover:bg-rose-50">
                Annullare Articolo
            </button>
            <button type="button" data-add-item disabled class="inline-flex items-center justify-center rounded-lg bg-rose-600 px-4 py-2 text-sm font-semibold text-white shadow-sm shadow-rose-600/20 transition-colors hover:bg-rose-700 disabled:cursor-not-allowed disabled:bg-slate-300 disabled:shadow-none">
                Add Articolo
            </button>
        </div>
    </div>

    <div class="px-6 pb-6">
        <div class="overflow-x-auto rounded-xl border border-slate-200">
            <table class="min-w-[900px] w-full text-left text-sm">
                <thead class="bg-slate-50 text-xs font-bold uppercase tracking-wide text-slate-500">
                    <tr>
                        <th class="px-4 py-3">Articolo</th>
                        <th class="px-4 py-3">Descrizione Articolo</th>
                        <th class="px-4 py-3 text-right">Prezzo</th>
                        <th class="px-4 py-3 text-center">Quantita acquistate</th>
                        <th class="px-4 py-3 text-right">Totale</th>
                        <th class="px-4 py-3 text-right">Task</th>
                    </tr>
                </thead>
                <tbody data-order-lines class="divide-y divide-slate-100 bg-white">
                    <tr data-empty-row>
                        <td colspan="6" class="px-4 py-8 text-center text-sm font-medium text-slate-400">Nessun articolo inserito.</td>
                    </tr>
                </tbody>
                <tfoot class="border-t border-slate-200 bg-slate-50 text-sm font-bold text-slate-700">
                    <tr>
                        <td colspan="4" class="px-4 py-3 text-right uppercase tracking-wide">Totale ordine</td>
                        <td class="px-4 py-3 text-right" data-order-total>@FormatEuro(0)</td>
                        <td class="px-4 py-3"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div data-hidden-items></div>
    </div>

    <div class="flex flex-col gap-3 border-t border-slate-100 px-6 py-5 sm:flex-row sm:justify-end">
        <a asp-controller="Home" asp-action="Orders" class="inline-flex items-center justify-center rounded-lg border border-rose-300 bg-white px-4 py-2 text-sm font-semibold text-rose-600 transition-colors hover:border-rose-400 hover:bg-rose-50">
            Annulla
        </a>
        <button type="submit" data-save-order disabled class="inline-flex items-center justify-center rounded-lg bg-rose-600 px-4 py-2 text-sm font-semibold text-white shadow-sm shadow-rose-600/20 transition-colors hover:bg-rose-700 disabled:cursor-not-allowed disabled:bg-slate-300 disabled:shadow-none">
            Salva
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const canEditItems = @Html.Raw(JsonSerializer.Serialize(canEditItems));
            const products = @Html.Raw(JsonSerializer.Serialize(productCatalog));
            const initialItems = @Html.Raw(JsonSerializer.Serialize(initialItems));
            const form = document.querySelector("[data-new-order-form]");
            const categorySelect = document.querySelector("[data-category-select]");
            const productSelect = document.querySelector("[data-product-select]");
            const quantityInput = document.querySelector("[data-quantity-input]");
            const addButton = document.querySelector("[data-add-item]");
            const clearButton = document.querySelector("[data-clear-selection]");
            const saveButton = document.querySelector("[data-save-order]");
            const linesBody = document.querySelector("[data-order-lines]");
            const emptyRow = document.querySelector("[data-empty-row]");
            const hiddenItems = document.querySelector("[data-hidden-items]");
            const orderTotal = document.querySelector("[data-order-total]");
            const nameBox = document.getElementById("SelectedProductName");
            const descriptionBox = document.getElementById("SelectedProductDescription");
            const priceBox = document.getElementById("SelectedProductPrice");
            const productImage = document.getElementById("SelectedProductImage");
            const imageFallback = document.getElementById("SelectedProductImageFallback");
            const formatter = new Intl.NumberFormat("it-IT", { style: "currency", currency: "EUR" });
            const selectedItems = [];

            function findProduct(code) {
                return products.find(product => product.code === code);
            }

            function formatEuro(value) {
                return formatter.format(value);
            }

            function selectedProductCodes() {
                return new Set(selectedItems.map(item => item.productCode));
            }

            function renderProducts() {
                const categoryCode = categorySelect.value;
                const currentValue = productSelect.value;
                const usedCodes = selectedProductCodes();
                productSelect.innerHTML = '<option value="">Seleziona articolo</option>';
                productSelect.disabled = !categoryCode;

                if (!categoryCode) {
                    clearProductDetails();
                    updateAddButton();
                    return;
                }

                products
                    .filter(product => product.categoryCode === categoryCode && product.stock > 0 && !usedCodes.has(product.code))
                    .forEach(product => {
                        const option = document.createElement("option");
                        option.value = product.code;
                        option.textContent = `${product.name} - ${formatEuro(product.unitCost)} - stock ${product.stock}`;
                        productSelect.appendChild(option);
                    });

                if ([...productSelect.options].some(option => option.value === currentValue)) {
                    productSelect.value = currentValue;
                } else {
                    productSelect.value = "";
                    clearProductDetails();
                }

                updateAddButton();
            }

            function renderProductDetails() {
                const product = findProduct(productSelect.value);
                if (!product) {
                    clearProductDetails();
                    return;
                }

                nameBox.value = product.name;
                descriptionBox.value = product.description || "";
                priceBox.value = formatEuro(product.unitCost);

                if (product.imageUrl) {
                    productImage.src = product.imageUrl;
                    productImage.alt = product.name;
                    productImage.classList.remove("hidden");
                    imageFallback.classList.add("hidden");
                } else {
                    productImage.removeAttribute("src");
                    productImage.alt = "";
                    productImage.classList.add("hidden");
                    imageFallback.classList.remove("hidden");
                }

                updateAddButton();
            }

            function clearProductDetails() {
                nameBox.value = "";
                descriptionBox.value = "";
                priceBox.value = "";
                productImage.removeAttribute("src");
                productImage.alt = "";
                productImage.classList.add("hidden");
                imageFallback.classList.remove("hidden");
            }

            function clearSelection() {
                categorySelect.value = "";
                productSelect.value = "";
                productSelect.disabled = true;
                productSelect.innerHTML = '<option value="">Seleziona articolo</option>';
                quantityInput.value = "";
                clearProductDetails();
                updateAddButton();
            }

            function updateAddButton() {
                const quantity = Number.parseInt(quantityInput.value, 10);
                const product = findProduct(productSelect.value);
                addButton.disabled = !product || Number.isNaN(quantity) || quantity <= 0 || quantity > product.stock;
            }

            function addOrReplaceItem(productCode, quantity) {
                const product = findProduct(productCode);
                if (!product || quantity <= 0 || quantity > product.stock) {
                    return;
                }

                const existingIndex = selectedItems.findIndex(item => item.productCode === productCode);
                const item = { productCode, quantity };

                if (existingIndex >= 0) {
                    selectedItems[existingIndex] = item;
                } else {
                    selectedItems.push(item);
                }

                renderOrderLines();
                clearSelection();
            }

            function editItem(productCode) {
                const itemIndex = selectedItems.findIndex(item => item.productCode === productCode);
                const item = selectedItems[itemIndex];
                const product = findProduct(productCode);
                if (!item || !product) {
                    return;
                }

                selectedItems.splice(itemIndex, 1);
                categorySelect.value = product.categoryCode;
                renderProducts();
                productSelect.value = product.code;
                quantityInput.value = item.quantity;
                renderProductDetails();
                renderOrderLines();
            }

            function deleteItem(productCode) {
                const itemIndex = selectedItems.findIndex(item => item.productCode === productCode);
                if (itemIndex >= 0) {
                    selectedItems.splice(itemIndex, 1);
                    renderProducts();
                    renderOrderLines();
                }
            }

            function updateItemQuantity(productCode, quantity) {
                const itemIndex = selectedItems.findIndex(item => item.productCode === productCode);
                const product = findProduct(productCode);
                if (itemIndex < 0 || !product) {
                    return;
                }

                if (Number.isNaN(quantity) || quantity <= 0) {
                    selectedItems[itemIndex].quantity = 1;
                } else if (quantity > product.stock) {
                    selectedItems[itemIndex].quantity = product.stock;
                } else {
                    selectedItems[itemIndex].quantity = quantity;
                }

                renderOrderLines();
            }

            function renderOrderLines() {
                linesBody.querySelectorAll("tr[data-line]").forEach(row => row.remove());
                hiddenItems.innerHTML = "";
                let total = 0;

                selectedItems.forEach((item, index) => {
                    const product = findProduct(item.productCode);
                    if (!product) {
                        return;
                    }

                    const lineTotal = product.unitCost * item.quantity;
                    total += lineTotal;

                    const row = document.createElement("tr");
                    row.dataset.line = product.code;
                    row.className = "align-top";
                    appendCell(row, product.name, "px-4 py-4 font-semibold text-slate-800");
                    appendCell(row, product.description || "", "px-4 py-4 text-slate-600");
                    appendCell(row, formatEuro(product.unitCost), "px-4 py-4 text-right text-slate-700");
                    const quantityCell = document.createElement("td");
                    quantityCell.className = "px-4 py-4 text-center";
                    const lineQuantityInput = document.createElement("input");
                    lineQuantityInput.type = "number";
                    lineQuantityInput.min = "1";
                    lineQuantityInput.max = product.stock.toString();
                    lineQuantityInput.step = "1";
                    lineQuantityInput.value = item.quantity.toString();
                    lineQuantityInput.dataset.lineQuantity = product.code;
                    lineQuantityInput.className = "mx-auto block w-20 rounded-lg border border-slate-200 px-3 py-2 text-center text-sm text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200";
                    quantityCell.appendChild(lineQuantityInput);
                    row.appendChild(quantityCell);
                    appendCell(row, formatEuro(lineTotal), "px-4 py-4 text-right font-bold text-slate-900");

                    const taskCell = document.createElement("td");
                    taskCell.className = "px-4 py-4";
                    const taskButtons = document.createElement("div");
                    taskButtons.className = "flex justify-end gap-2";
                    const deleteButton = document.createElement("button");
                    deleteButton.type = "button";
                    deleteButton.dataset.deleteItem = product.code;
                    deleteButton.className = "rounded-lg border border-rose-300 px-3 py-1.5 text-xs font-semibold text-rose-600 transition-colors hover:border-rose-400 hover:bg-rose-50";
                    deleteButton.textContent = "Delete Articolo";
                    if (canEditItems) {
                        const editButton = document.createElement("button");
                        editButton.type = "button";
                        editButton.dataset.editItem = product.code;
                        editButton.className = "rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-600 transition-colors hover:border-slate-300 hover:bg-slate-50";
                        editButton.textContent = "Edit";
                        taskButtons.appendChild(editButton);
                    }

                    taskButtons.appendChild(deleteButton);
                    taskCell.appendChild(taskButtons);
                    row.appendChild(taskCell);
                    linesBody.appendChild(row);

                    appendHiddenItem(index, product.code, item.quantity);
                });

                emptyRow.classList.toggle("hidden", selectedItems.length > 0);
                orderTotal.textContent = formatEuro(total);
                saveButton.disabled = selectedItems.length === 0;
            }

            function appendCell(row, value, className) {
                const cell = document.createElement("td");
                cell.className = className;
                cell.textContent = value;
                row.appendChild(cell);
            }

            function appendHiddenItem(index, productCode, quantity) {
                const productInput = document.createElement("input");
                productInput.type = "hidden";
                productInput.name = `Items[${index}].ProductCode`;
                productInput.value = productCode;

                const quantityInput = document.createElement("input");
                quantityInput.type = "hidden";
                quantityInput.name = `Items[${index}].Quantity`;
                quantityInput.value = quantity.toString();

                hiddenItems.append(productInput, quantityInput);
            }

            categorySelect.addEventListener("change", renderProducts);
            productSelect.addEventListener("change", renderProductDetails);
            quantityInput.addEventListener("input", updateAddButton);
            clearButton.addEventListener("click", clearSelection);
            addButton.addEventListener("click", () => addOrReplaceItem(productSelect.value, Number.parseInt(quantityInput.value, 10)));
            form.addEventListener("submit", () => renderOrderLines());
            productImage.addEventListener("error", () => {
                productImage.classList.add("hidden");
                imageFallback.classList.remove("hidden");
            });
            linesBody.addEventListener("click", event => {
                const editButton = event.target.closest("[data-edit-item]");
                const deleteButton = event.target.closest("[data-delete-item]");
                if (editButton) {
                    editItem(editButton.dataset.editItem);
                }
                if (deleteButton) {
                    deleteItem(deleteButton.dataset.deleteItem);
                }
            });
            linesBody.addEventListener("input", event => {
                const lineQuantityInput = event.target.closest("[data-line-quantity]");
                if (!lineQuantityInput) {
                    return;
                }

                updateItemQuantity(
                    lineQuantityInput.dataset.lineQuantity,
                    Number.parseInt(lineQuantityInput.value, 10));
            });

            initialItems.forEach(item => addOrReplaceItem(item.productCode, item.quantity));
            renderProducts();
            renderOrderLines();
        })();
    </script>
}
