@model DashboardOrders.Models.DashboardViewModel
@{
    ViewData["Title"] = "Panoramica";
    var currentSortBy = Model.SortBy;
    var currentSortDirection = Model.SortDirection;

    Dictionary<string, string> DashboardRouteValues()
    {
        return new Dictionary<string, string>
        {
            ["search"] = Model.SearchTerm
        };
    }

    SortableHeaderViewModel DashboardHeader(string column, string label, string alignment = "left")
    {
        return new SortableHeaderViewModel
        {
            ActionName = "Index",
            ControllerName = "Home",
            Column = column,
            Label = label,
            CurrentSortBy = currentSortBy,
            CurrentSortDirection = currentSortDirection,
            PageSize = Model.PageSize,
            Alignment = alignment,
            ExtraRouteValues = DashboardRouteValues()
        };
    }
}

<!-- Page Header -->
<div class="mb-8">
    <h2 class="text-2xl font-bold text-slate-800">Panoramica</h2>
    <p class="text-slate-500 mt-1">
        @if (Model.HasActiveSearch)
        {
            <span>Risultati filtro per <span class="font-semibold text-slate-700">"@Model.SearchTerm"</span>.</span>
        }
        else
        {
            <span>Benvenuto! Ecco il riepilogo degli ordini aggiornato al @DateTime.Now.ToString("dd MMMM yyyy").</span>
        }
    </p>
</div>

<!-- KPI Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-6 mb-8">
    
    <!-- Card: Ordini Totali -->
    <div class="bg-white rounded-2xl shadow-sm p-6 flex items-center space-x-4 border border-slate-100 hover:shadow-md transition-shadow">
        <div class="h-14 w-14 rounded-xl bg-indigo-100 flex items-center justify-center shrink-0">
            <svg class="w-7 h-7 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
        </div>
        <div>
            <p class="text-sm font-medium text-slate-500">Ordini Totali</p>
            <p class="text-3xl font-bold text-slate-800">@Model.TotalOrders</p>
        </div>
    </div>

    <!-- Card: Fatturato -->
    <div class="bg-white rounded-2xl shadow-sm p-6 flex items-center space-x-4 border border-slate-100 hover:shadow-md transition-shadow">
        <div class="h-14 w-14 rounded-xl bg-emerald-100 flex items-center justify-center shrink-0">
            <svg class="w-7 h-7 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <div>
            <p class="text-sm font-medium text-slate-500">Fatturato</p>
            <p class="text-3xl font-bold text-slate-800">@FormatEuro(Model.TotalRevenue, "N0")</p>
        </div>
    </div>

    <!-- Card: In Attesa -->
    <div class="bg-white rounded-2xl shadow-sm p-6 flex items-center space-x-4 border border-slate-100 hover:shadow-md transition-shadow">
        <div class="h-14 w-14 rounded-xl bg-amber-100 flex items-center justify-center shrink-0">
            <svg class="w-7 h-7 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <div>
            <p class="text-sm font-medium text-slate-500">In Attesa / Elaboraz.</p>
            <p class="text-3xl font-bold text-slate-800">@Model.PendingOrders</p>
        </div>
    </div>

    <!-- Card: Clienti -->
    <div class="bg-white rounded-2xl shadow-sm p-6 flex items-center space-x-4 border border-slate-100 hover:shadow-md transition-shadow">
        <div class="h-14 w-14 rounded-xl bg-purple-100 flex items-center justify-center shrink-0">
            <svg class="w-7 h-7 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
        </div>
        <div>
            <p class="text-sm font-medium text-slate-500">Clienti Attivi</p>
            <p class="text-3xl font-bold text-slate-800">@Model.ActiveCustomers</p>
        </div>
    </div>
</div>

<!-- Tabella Ordini Recenti -->
<div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between">
        <h3 class="text-lg font-semibold text-slate-800">Ordini Recenti</h3>
        <span class="text-sm text-slate-500">Totale: @Model.TotalOrders ordini</span>
    </div>
    <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/70 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <partial name="_PageSizeSelector" model="@(new PageSizeSelectorViewModel
        {
            ActionName = "Index",
            ControllerName = "Home",
            PageSize = Model.PageSize,
            SortBy = Model.SortBy,
            SortDirection = Model.SortDirection,
            ExtraRouteValues = DashboardRouteValues()
        })" />

        <div class="text-sm text-slate-500">
            @if (Model.ShowAll)
            {
                <span>Tutti gli ordini in una sola pagina</span>
            }
            else
            {
                <span>Pagina @Model.CurrentPage di @Model.TotalPages</span>
            }
        </div>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead>
                <tr class="bg-slate-50 border-b border-slate-100">
                    <th class="px-6 py-3 text-left">
                        <partial name="_SortableHeader" model='@DashboardHeader("orderNumber", "N° Ordine")' />
                    </th>
                    <th class="px-6 py-3 text-left">
                        <partial name="_SortableHeader" model='@DashboardHeader("customer", "Cliente")' />
                    </th>
                    <th class="px-6 py-3 text-left">
                        <partial name="_SortableHeader" model='@DashboardHeader("items", "Articoli")' />
                    </th>
                    <th class="px-6 py-3 text-left">
                        <partial name="_SortableHeader" model='@DashboardHeader("date", "Data")' />
                    </th>
                    <th class="px-6 py-3 text-right">
                        <partial name="_SortableHeader" model='@DashboardHeader("amount", "Importo", "right")' />
                    </th>
                    <th class="px-6 py-3 text-center">
                        <partial name="_SortableHeader" model='@DashboardHeader("status", "Stato", "center")' />
                    </th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50">
                @foreach (var order in Model.RecentOrders)
                {
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-6 py-4 font-medium text-sm text-indigo-600">@order.OrderNumber</td>
                        <td class="px-6 py-4">
                            <div class="flex items-center space-x-3">
                                <div class="h-8 w-8 rounded-full bg-gradient-to-br from-indigo-400 to-purple-500 text-white text-xs font-bold flex items-center justify-center shrink-0">
                                    @order.Customer.AvatarInitials
                                </div>
                                <div>
                                    <p class="text-sm font-medium text-slate-800">@order.Customer.Name</p>
                                    <p class="text-xs text-slate-400">@order.Customer.Email</p>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-sm text-slate-600">
                            <p class="font-medium text-slate-700">@order.Product</p>
                            <p class="text-xs text-slate-400">
                                @if (order.ItemsCount > 1)
                                {
                                    <span>@order.ItemsCount articoli, @order.Quantity pezzi totali</span>
                                }
                                else
                                {
                                    <span>x@order.Quantity</span>
                                }
                            </p>
                        </td>
                        <td class="px-6 py-4 text-sm text-slate-500">@order.OrderDate.ToString("dd/MM/yyyy")</td>
                        <td class="px-6 py-4 text-sm font-semibold text-slate-800 text-right">@FormatEuro(order.TotalAmount)</td>
                        <td class="px-6 py-4 text-center">
                            @{
                                var statusPresentation = OrderStatusPresentation.FromStatus(order.Status);
                            }
                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold"
                                  style="background-color: @statusPresentation.BackgroundColor; color: @statusPresentation.ForegroundColor;">
                                @statusPresentation.Label
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" model="@(new PaginationViewModel
    {
        ActionName = "Index",
        ControllerName = "Home",
        EntityLabel = "ordini",
        CurrentPage = Model.CurrentPage,
        PageSize = Model.PageSize,
        TotalPages = Model.TotalPages,
        TotalItems = Model.TotalOrders,
        DisplayedItems = Model.RecentOrders.Count,
        SortBy = Model.SortBy,
        SortDirection = Model.SortDirection,
        ExtraRouteValues = DashboardRouteValues()
    })" />
</div>
