@model DashboardOrders.Models.CheckoutSessionViewModel
@{
    ViewData["Title"] = "Spedizione e fatturazione";
}

<div class="mb-6">
    <h2 class="text-3xl font-bold text-slate-900">Spedizione e fatturazione</h2>
    <p class="mt-1 text-sm text-slate-500">Dati usati solo per simulare il checkout. Non viene generata fattura reale.</p>
</div>

<form method="post" asp-controller="Home" asp-action="CheckoutAddresses" class="space-y-6">
    @Html.AntiForgeryToken()
    <section class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
        <h3 class="text-lg font-semibold text-slate-900">Spedizione</h3>
        <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
            <input asp-for="ShippingFullName" placeholder="Nome e cognome" class="rounded-lg border border-slate-200 px-3 py-2 text-sm" />
            <input asp-for="ShippingPhone" placeholder="Telefono" class="rounded-lg border border-slate-200 px-3 py-2 text-sm" />
            <input asp-for="ShippingAddressLine" placeholder="Indirizzo" class="rounded-lg border border-slate-200 px-3 py-2 text-sm md:col-span-2" />
            <input asp-for="ShippingCity" placeholder="Citta" class="rounded-lg border border-slate-200 px-3 py-2 text-sm" />
            <input asp-for="ShippingPostalCode" placeholder="CAP" class="rounded-lg border border-slate-200 px-3 py-2 text-sm" />
            <input asp-for="ShippingCountry" placeholder="Paese" class="rounded-lg border border-slate-200 px-3 py-2 text-sm" />
        </div>
    </section>

    <section class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
        <label class="flex items-center gap-2 text-sm font-semibold text-slate-800">
            <input asp-for="BillingSameAsShipping" class="h-4 w-4 rounded border-slate-300 text-indigo-600" />
            Fatturazione uguale alla spedizione
        </label>
        <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
            <input asp-for="BillingFullName" placeholder="Intestatario fatturazione" class="rounded-lg border border-slate-200 px-3 py-2 text-sm" />
            <input asp-for="BillingVatNumber" placeholder="P.IVA/Codice test" class="rounded-lg border border-slate-200 px-3 py-2 text-sm" />
            <input asp-for="BillingAddressLine" placeholder="Indirizzo fatturazione" class="rounded-lg border border-slate-200 px-3 py-2 text-sm md:col-span-2" />
            <input asp-for="BillingCity" placeholder="Citta" class="rounded-lg border border-slate-200 px-3 py-2 text-sm" />
            <input asp-for="BillingPostalCode" placeholder="CAP" class="rounded-lg border border-slate-200 px-3 py-2 text-sm" />
            <input asp-for="BillingCountry" placeholder="Paese" class="rounded-lg border border-slate-200 px-3 py-2 text-sm" />
        </div>
    </section>

    <div class="flex flex-col gap-3 sm:flex-row sm:justify-between">
        <a asp-controller="Home" asp-action="CheckoutSummary" class="inline-flex items-center justify-center rounded-lg border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700">Indietro</a>
        <button type="submit" class="inline-flex items-center justify-center rounded-lg bg-indigo-600 px-5 py-2 text-sm font-semibold text-white">Salva e continua</button>
    </div>
</form>
