@model DashboardOrders.Models.CheckoutSessionViewModel
@{
    ViewData["Title"] = "Conferma checkout";
}

<div class="mb-6">
    <h2 class="text-3xl font-bold text-slate-900">Conferma finale</h2>
    <p class="mt-1 text-sm text-slate-500">Scegli consegna e pagamento test, poi crea l'ordine.</p>
</div>

<div class="grid grid-cols-1 gap-5 lg:grid-cols-[minmax(0,1fr)_340px]">
    <section class="space-y-5">
        <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
            <h3 class="text-lg font-semibold text-slate-900">Spedizione</h3>
            <p class="mt-2 text-sm text-slate-700">@Model.ShippingFullName</p>
            <p class="text-sm text-slate-500">@Model.ShippingAddressLine, @Model.ShippingPostalCode @Model.ShippingCity, @Model.ShippingCountry</p>
            <p class="text-sm text-slate-500">@Model.ShippingPhone</p>
        </div>

        <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
            <h3 class="text-lg font-semibold text-slate-900">Fatturazione test</h3>
            <p class="mt-2 text-sm text-slate-700">@Model.BillingFullName</p>
            <p class="text-sm text-slate-500">@Model.BillingAddressLine, @Model.BillingPostalCode @Model.BillingCity, @Model.BillingCountry</p>
            @if (!string.IsNullOrWhiteSpace(Model.BillingVatNumber))
            {
                <p class="text-sm text-slate-500">Codice test: @Model.BillingVatNumber</p>
            }
        </div>

        <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
            <h3 class="text-lg font-semibold text-slate-900">Articoli</h3>
            <div class="mt-3 divide-y divide-slate-100">
                @foreach (var item in Model.Cart.Items)
                {
                    <div class="flex justify-between gap-3 py-3 text-sm">
                        <span class="text-slate-700">@item.ProductName x @item.Quantity</span>
                        <span class="font-semibold text-slate-900">@FormatEuro(item.LineTotal)</span>
                    </div>
                }
            </div>
        </div>
    </section>

    <aside class="h-max rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
        <form method="post" asp-controller="Home" asp-action="CheckoutConfirm" class="space-y-4">
            @Html.AntiForgeryToken()
            <div>
                <label asp-for="DeliveryMethod" class="text-sm font-semibold text-slate-700">Consegna</label>
                <select asp-for="DeliveryMethod" class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm">
                    <option value="standard">Standard test</option>
                    <option value="express">Express test</option>
                    <option value="pickup">Ritiro test</option>
                </select>
            </div>
            <div>
                <label asp-for="PaymentMethod" class="text-sm font-semibold text-slate-700">Pagamento</label>
                <select asp-for="PaymentMethod" class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm">
                    <option value="pending">Ordine pending senza addebito</option>
                    <option value="test-card">Pagamento test simulato</option>
                </select>
            </div>

            <div class="border-t border-slate-100 pt-5">
                <p class="text-sm text-slate-500">Totale ordine</p>
                <p class="mt-1 text-2xl font-bold text-slate-900">@FormatEuro(Model.Cart.TotalAmount)</p>
                <button type="submit" class="inline-flex w-full items-center justify-center rounded-full bg-amber-400 px-5 py-3 text-sm font-bold text-slate-950 hover:bg-amber-500">
                    Crea ordine
                </button>
            </div>
        </form>
    </aside>
</div>
