@model DashboardOrders.Models.OrdersPageViewModel
@using DashboardOrders.Services
@{
    ViewData["Title"] = "Ordini";
    var currentSortBy = Model.SortBy;
    var currentSortDirection = Model.SortDirection;
    var isAdmin = User.IsInRole("Admin");

    Dictionary<string, string> OrderRouteValues()
    {
        return new Dictionary<string, string>
        {
            ["customerId"] = Model.SelectedCustomerId?.ToString() ?? string.Empty,
            ["search"] = Model.SearchTerm,
            ["dateFrom"] = Model.DateFrom,
            ["dateTo"] = Model.DateTo
        };
    }

    SortableHeaderViewModel OrderHeader(string column, string label, string alignment = "left")
    {
        return new SortableHeaderViewModel
        {
            ActionName = "Orders",
            ControllerName = "Home",
            Column = column,
            Label = label,
            CurrentSortBy = currentSortBy,
            CurrentSortDirection = currentSortDirection,
            PageSize = Model.PageSize,
            Alignment = alignment,
            ExtraRouteValues = OrderRouteValues()
        };
    }

    List<OrderStatus> NextStatuses(OrderStatus currentStatus)
    {
        return Enum.GetValues<OrderStatus>()
            .Where(status => OrderStatusTransitionPolicy.CanTransition(currentStatus, status))
            .ToList();
    }

    string StatusLabel(OrderStatus status)
    {
        return OrderStatusPresentation.FromStatus(status).Label;
    }

    string TransitionLabel(OrderStatusHistory history)
    {
        return history.FromStatus.HasValue
            ? $"{StatusLabel(history.FromStatus.Value)} -> {StatusLabel(history.ToStatus)}"
            : $"Creato come {StatusLabel(history.ToStatus)}";
    }
}

<div class="mb-8">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <h2 class="text-2xl font-bold text-slate-800">Ordini</h2>
        @if (!isAdmin)
        {
            <a asp-controller="Home"
               asp-action="NewOrder"
               class="inline-flex items-center justify-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm shadow-indigo-600/20 transition-colors hover:bg-indigo-700">
                Nuovo ordine
            </a>
        }
    </div>
    <p class="text-slate-500 mt-1">
        @if (Model.HasCustomerFilter)
        {
            if (Model.HasActiveSearch)
            {
                <span>Risultati filtro per <span class="font-semibold text-slate-700">"@Model.SearchTerm"</span> negli ordini di <span class="font-semibold text-slate-700">@Model.SelectedCustomerName</span>.</span>
            }
            else
            {
                <span>Visualizzazione filtrata sugli ordini del cliente <span class="font-semibold text-slate-700">@Model.SelectedCustomerName</span>.</span>
            }
        }
        else if (Model.HasActiveSearch || Model.HasDateFilter)
        {
            <span>Risultati filtrati per ricerca e intervallo date.</span>
        }
        else
        {
            <span>Panoramica ordini con dettaglio di data, importo e stato per ogni registrazione.</span>
        }
    </p>
</div>

@if (Model.HasCustomerFilter)
{
    <div class="mb-6 flex flex-col gap-3 rounded-2xl border border-indigo-100 bg-indigo-50/70 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600">Filtro attivo</p>
            <p class="text-sm text-slate-600">Stai visualizzando solo gli ordini di <span class="font-semibold text-slate-800">@Model.SelectedCustomerName</span>.</p>
        </div>
        @if (isAdmin)
        {
            <a asp-action="Orders"
               asp-controller="Home"
               asp-route-search="@Model.SearchTerm"
               class="inline-flex items-center justify-center rounded-lg border border-indigo-200 bg-white px-4 py-2 text-sm font-semibold text-indigo-600 transition-colors hover:border-indigo-300 hover:text-indigo-700">
                Mostra tutti gli ordini
            </a>
        }
    </div>
}

<partial name="_FilterPanel" />
<div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3 mb-8">
    <div class="bg-white rounded-2xl shadow-sm p-6 flex items-center space-x-4 border border-slate-100 hover:shadow-md transition-shadow">
        <div class="h-14 w-14 rounded-xl bg-indigo-100 flex items-center justify-center shrink-0">
            <svg class="w-7 h-7 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
        </div>
        <div>
            <p class="text-sm font-medium text-slate-500">Ordini Totali</p>
            <p class="text-3xl font-bold text-slate-800">@Model.TotalOrders</p>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm p-6 flex items-center space-x-4 border border-slate-100 hover:shadow-md transition-shadow">
        <div class="h-14 w-14 rounded-xl bg-emerald-100 flex items-center justify-center shrink-0">
            <svg class="w-7 h-7 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <div>
            <p class="text-sm font-medium text-slate-500">Importo Totale</p>
            <p class="text-3xl font-bold text-slate-800">@FormatEuro(Model.TotalRevenue, "N0")</p>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm p-6 flex items-center space-x-4 border border-slate-100 hover:shadow-md transition-shadow md:col-span-2 xl:col-span-1">
        <div class="h-14 w-14 rounded-xl bg-amber-100 flex items-center justify-center shrink-0">
            <svg class="w-7 h-7 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <div class="space-y-1">
            <p class="text-sm font-medium text-slate-500">Stato Ordini</p>
            <div class="flex flex-wrap items-center gap-2 text-sm font-semibold">
                <span class="inline-flex items-center rounded-full bg-amber-50 px-3 py-1 text-amber-700">@Model.PendingOrders attivi</span>
                <span class="inline-flex items-center rounded-full bg-blue-50 px-3 py-1 text-blue-700"
                      style="margin-left: 0.5rem;">@Model.ShippedOrders evasi</span>
            </div>
        </div>
    </div>
</div>

<div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between">
        <h3 class="text-lg font-semibold text-slate-800">Elenco Ordini</h3>
        <span class="text-sm text-slate-500">Totale: @Model.TotalOrders ordini</span>
    </div>
    <partial name="_PaginationControls" model="Model" />

    <div class="space-y-4 p-4 md:hidden">
        @foreach (var order in Model.Orders)
        {
            var statusPresentation = OrderStatusPresentation.FromStatus(order.Status);
            var mobileNextStatuses = NextStatuses(order.Status);
            var detailCardId = $"order-mobile-detail-{order.Id}";
            var detailButtonId = $"order-mobile-detail-button-{order.Id}";

            <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                <div class="flex items-start gap-4 px-4 py-4">
                    <span class="mt-1 h-14 w-1.5 rounded-full @statusPresentation.RowAccent"></span>
                    <div class="min-w-0 flex-1">
                        <div class="flex flex-wrap items-center justify-between gap-3">
                            <div>
                                <p class="text-sm font-semibold tracking-wide text-indigo-600">@order.OrderNumber</p>
                                <p class="mt-1 text-base font-semibold text-slate-800">@order.Customer.Name</p>
                            </div>
                            <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold"
                                  style="background-color: @statusPresentation.BackgroundColor; color: @statusPresentation.ForegroundColor;">
                                @statusPresentation.Label
                            </span>
                        </div>

                        <dl class="mt-4 grid grid-cols-2 gap-3 text-sm">
                            <div class="rounded-xl bg-slate-50 px-3 py-2">
                                <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Data</dt>
                                <dd class="mt-1 font-medium text-slate-700">@order.OrderDate.ToString("dd/MM/yyyy")</dd>
                            </div>
                            <div class="rounded-xl bg-slate-50 px-3 py-2">
                                <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Importo</dt>
                                <dd class="mt-1 font-semibold text-slate-800">@FormatEuro(order.TotalAmount)</dd>
                            </div>
                            <div class="rounded-xl bg-slate-50 px-3 py-2">
                                <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Articoli</dt>
                                <dd class="mt-1 font-medium text-slate-700">@order.ItemsCount righe</dd>
                            </div>
                            <div class="rounded-xl bg-slate-50 px-3 py-2">
                                <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Quantita</dt>
                                <dd class="mt-1 font-medium text-slate-700">@order.Quantity pezzi</dd>
                            </div>
                        </dl>

                        <div class="mt-4 flex items-center justify-between gap-3">
                            <p class="truncate text-sm text-slate-500">@order.Customer.Email</p>
                            <button type="button"
                                    id="@detailButtonId"
                                    class="order-detail-toggle inline-flex shrink-0 items-center rounded-lg border border-indigo-200 bg-indigo-50 px-4 py-2 text-sm font-semibold text-indigo-600 transition-colors hover:border-indigo-300 hover:bg-indigo-100 hover:text-indigo-700"
                                    data-target="@detailCardId"
                                    aria-expanded="false"
                                    aria-controls="@detailCardId">
                                Dettaglio
                            </button>
                        </div>

                        @if (isAdmin)
                        {
                            <div class="mt-4 rounded-xl border border-slate-200 bg-slate-50 px-3 py-3">
                                <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Avanza stato</p>
                                @if (mobileNextStatuses.Count == 0)
                                {
                                    <p class="mt-2 text-sm text-slate-500">Nessuna transizione disponibile.</p>
                                }
                                else
                                {
                                    <div class="mt-3 space-y-2">
                                        @foreach (var nextStatus in mobileNextStatuses)
                                        {
                                            var requiresReason = OrderStatusTransitionPolicy.RequiresReason(nextStatus);
                                            <form method="post" asp-controller="Home" asp-action="ChangeOrderStatus" class="flex flex-col gap-2 rounded-lg border border-white bg-white p-2 shadow-sm">
                                                <input type="hidden" name="orderId" value="@order.Id" />
                                                <input type="hidden" name="newStatus" value="@((int)nextStatus)" />
                                                @if (requiresReason)
                                                {
                                                    <input type="text"
                                                           name="reason"
                                                           required
                                                           maxlength="500"
                                                           placeholder="Motivazione obbligatoria"
                                                           class="rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100" />
                                                }
                                                <button type="submit"
                                                        class="inline-flex items-center justify-center rounded-lg bg-slate-800 px-3 py-2 text-sm font-semibold text-white transition-colors hover:bg-slate-900">
                                                    Porta a @StatusLabel(nextStatus)
                                                </button>
                                            </form>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div id="@detailCardId" class="order-detail-row hidden border-t border-slate-100 bg-slate-50/80 px-4 py-4">
                    <div class="space-y-3">
                        @foreach (var item in order.Items)
                        {
                            <div class="rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="min-w-0">
                                        <p class="text-sm font-semibold text-slate-800">@item.ProductName</p>
                                        <p class="mt-1 text-xs text-slate-500">Qtà @item.Quantity x @FormatEuro(item.UnitPrice)</p>
                                    </div>
                                    <p class="text-sm font-semibold text-slate-800">@FormatEuro(item.TotalPrice)</p>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="mt-4 rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm">
                        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Storico stati</p>
                        @if (order.StatusHistory.Count == 0)
                        {
                            <p class="mt-2 text-sm text-slate-500">Nessuno storico disponibile.</p>
                        }
                        else
                        {
                            <div class="mt-3 space-y-3">
                                @foreach (var history in order.StatusHistory)
                                {
                                    <div class="border-l-2 border-indigo-200 pl-3">
                                        <p class="text-sm font-semibold text-slate-800">@TransitionLabel(history)</p>
                                        <p class="mt-1 text-xs text-slate-500">
                                            @history.ChangedAt.ToString("dd/MM/yyyy HH:mm")
                                            @if (!string.IsNullOrWhiteSpace(history.ChangedBy))
                                            {
                                                <span> · @history.ChangedBy</span>
                                            }
                                        </p>
                                        @if (!string.IsNullOrWhiteSpace(history.Reason))
                                        {
                                            <p class="mt-1 text-sm text-slate-600">@history.Reason</p>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </article>
        }
    </div>

    <div class="hidden overflow-x-auto md:block">
        <table class="w-full">
            <thead>
                <tr class="bg-slate-50 border-b border-slate-100">
                    <th class="px-6 py-4 text-left">
                        <partial name="_SortableHeader" model='@OrderHeader("orderNumber", "N# Ordine")' />
                    </th>
                    <th class="px-6 py-4 text-left">
                        <partial name="_SortableHeader" model='@OrderHeader("date", "Data")' />
                    </th>
                    <th class="px-6 py-4 text-right">
                        <partial name="_SortableHeader" model='@OrderHeader("amount", "Importo", "right")' />
                    </th>
                    <th class="px-6 py-4 text-center">
                        <partial name="_SortableHeader" model='@OrderHeader("status", "Stato", "center")' />
                    </th>
                    <th class="text-center text-xs font-semibold text-slate-500 uppercase tracking-wider px-6 py-4">Dett. Ordine</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50">
                @foreach (var order in Model.Orders)
                {
                    var statusPresentation = OrderStatusPresentation.FromStatus(order.Status);
                    var desktopNextStatuses = NextStatuses(order.Status);
                    var detailRowId = $"order-detail-{order.Id}";
                    var detailButtonId = $"order-detail-button-{order.Id}";

                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-4">
                                <span class="h-10 w-1.5 rounded-full @statusPresentation.RowAccent"></span>
                                <div>
                                    <p class="text-sm font-semibold text-indigo-600">@order.OrderNumber</p>
                                    <p class="text-xs text-slate-400">@order.Customer.Name</p>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-sm text-slate-600">@order.OrderDate.ToString("dd/MM/yyyy")</td>
                        <td class="px-6 py-4 text-right text-sm font-semibold text-slate-800">@FormatEuro(order.TotalAmount)</td>
                        <td class="px-6 py-4 text-center">
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold"
                                  style="background-color: @statusPresentation.BackgroundColor; color: @statusPresentation.ForegroundColor;">
                                @statusPresentation.Label
                            </span>
                        </td>
                        <td class="px-6 py-4 text-center">
                            <button type="button"
                                    id="@detailButtonId"
                                    class="order-detail-toggle inline-flex items-center rounded-lg border border-indigo-200 bg-indigo-50 px-4 py-2 text-sm font-semibold text-indigo-600 transition-colors hover:border-indigo-300 hover:bg-indigo-100 hover:text-indigo-700"
                                    data-target="@detailRowId"
                                    aria-expanded="false"
                                    aria-controls="@detailRowId">
                                Dettaglio
                            </button>
                        </td>
                    </tr>
                    <tr id="@detailRowId" class="order-detail-row hidden bg-slate-50/80">
                        <td colspan="5" class="px-6 pb-6 pt-2">
                            <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                                <div class="border-b border-amber-200 bg-amber-100 px-5 py-4"
                                     style="padding-left: 2rem; padding-right: 2rem;">
                                    <div class="flex flex-wrap items-center gap-x-8 gap-y-2 text-sm"
                                         style="display: flex; flex-wrap: wrap; align-items: center; column-gap: 2rem; row-gap: 0.5rem;">
                                        <p class="font-semibold text-slate-800">Dettaglio ordine @order.OrderNumber</p>
                                        <p class="text-slate-500">Numero articoli: <span class="font-semibold text-slate-700">@order.ItemsCount</span></p>
                                        <p class="text-slate-500">Pezzi Totali: <span class="font-semibold text-slate-700">@order.Quantity</span></p>
                                        <p class="text-slate-500">Cliente: <span class="font-semibold text-slate-700">@order.Customer.Name</span></p>
                                    </div>
                                    @if (isAdmin)
                                    {
                                        <div class="mt-4 rounded-xl border border-amber-200 bg-white/70 px-4 py-3">
                                            <p class="text-xs font-semibold uppercase tracking-wide text-amber-700">Avanza stato ordine</p>
                                            @if (desktopNextStatuses.Count == 0)
                                            {
                                                <p class="mt-2 text-sm text-slate-500">Nessuna transizione disponibile per lo stato corrente.</p>
                                            }
                                            else
                                            {
                                                <div class="mt-3 flex flex-wrap gap-3">
                                                    @foreach (var nextStatus in desktopNextStatuses)
                                                    {
                                                        var requiresReason = OrderStatusTransitionPolicy.RequiresReason(nextStatus);
                                                        <form method="post" asp-controller="Home" asp-action="ChangeOrderStatus" class="flex flex-wrap items-center gap-2 rounded-lg border border-amber-100 bg-white px-3 py-2 shadow-sm">
                                                            <input type="hidden" name="orderId" value="@order.Id" />
                                                            <input type="hidden" name="newStatus" value="@((int)nextStatus)" />
                                                            @if (requiresReason)
                                                            {
                                                                <input type="text"
                                                                       name="reason"
                                                                       required
                                                                       maxlength="500"
                                                                       placeholder="Motivazione obbligatoria"
                                                                       class="w-56 rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100" />
                                                            }
                                                            <button type="submit"
                                                                    class="inline-flex items-center justify-center rounded-lg bg-slate-800 px-3 py-2 text-sm font-semibold text-white transition-colors hover:bg-slate-900">
                                                                Porta a @StatusLabel(nextStatus)
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="overflow-x-auto">
                                    <table class="w-full min-w-[640px]">
                                        <thead>
                                            <tr class="border-b border-slate-100 bg-white">
                                                <th class="pl-8 pr-5 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"
                                                    style="padding-left: 2rem;">Articolo</th>
                                                <th class="px-5 py-3 text-center text-xs font-semibold uppercase tracking-wider text-slate-500">Qtà</th>
                                                <th class="px-5 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">Prezzo Unitario</th>
                                                <th class="pl-5 pr-8 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500"
                                                    style="padding-right: 2rem;">Totale Riga</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-100">
                                            @foreach (var item in order.Items)
                                            {
                                                <tr class="transition-colors hover:bg-slate-50">
                                                    <td class="pl-8 pr-5 py-3 text-sm font-medium text-slate-700"
                                                        style="padding-left: 2rem;">@item.ProductName</td>
                                                    <td class="px-5 py-3 text-center text-sm text-slate-600">@item.Quantity</td>
                                                    <td class="px-5 py-3 text-right text-sm text-slate-600">@FormatEuro(item.UnitPrice)</td>
                                                    <td class="pl-5 pr-8 py-3 text-right text-sm font-semibold text-slate-800"
                                                        style="padding-right: 2rem;">@FormatEuro(item.TotalPrice)</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr class="border-t border-slate-200 bg-slate-50">
                                                <td colspan="3" class="px-5 py-4 text-right text-sm font-semibold uppercase tracking-wide text-slate-500">Totale Ordine</td>
                                                <td class="pl-5 pr-8 py-4 text-right text-base font-bold text-slate-800"
                                                    style="padding-right: 2rem;">@FormatEuro(order.TotalAmount)</td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                                <div class="border-t border-slate-100 bg-slate-50 px-5 py-4"
                                     style="padding-left: 2rem; padding-right: 2rem;">
                                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Storico stati</p>
                                    @if (order.StatusHistory.Count == 0)
                                    {
                                        <p class="mt-2 text-sm text-slate-500">Nessuno storico disponibile per questo ordine.</p>
                                    }
                                    else
                                    {
                                        <div class="mt-4 grid gap-3 lg:grid-cols-2">
                                            @foreach (var history in order.StatusHistory)
                                            {
                                                <div class="rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm">
                                                    <div class="flex items-start gap-3">
                                                        <span class="mt-1 h-3 w-3 rounded-full bg-indigo-500"></span>
                                                        <div class="min-w-0">
                                                            <p class="text-sm font-semibold text-slate-800">@TransitionLabel(history)</p>
                                                            <p class="mt-1 text-xs text-slate-500">
                                                                @history.ChangedAt.ToString("dd/MM/yyyy HH:mm")
                                                                @if (!string.IsNullOrWhiteSpace(history.ChangedBy))
                                                                {
                                                                    <span> · @history.ChangedBy</span>
                                                                }
                                                            </p>
                                                            @if (!string.IsNullOrWhiteSpace(history.Reason))
                                                            {
                                                                <p class="mt-2 text-sm text-slate-600">@history.Reason</p>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" model="@(new PaginationViewModel
    {
        ActionName = "Orders",
        ControllerName = "Home",
        EntityLabel = "ordini",
        CurrentPage = Model.CurrentPage,
        PageSize = Model.PageSize,
        TotalPages = Model.TotalPages,
        TotalItems = Model.TotalOrders,
        DisplayedItems = Model.Orders.Count,
        SortBy = Model.SortBy,
        SortDirection = Model.SortDirection,
        ExtraRouteValues = OrderRouteValues()
    })" />
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const detailButtons = document.querySelectorAll('.order-detail-toggle');

            detailButtons.forEach(button => {
                button.addEventListener('click', function () {
                    const targetId = this.getAttribute('data-target');
                    const detailRow = document.getElementById(targetId);

                    if (!detailRow) {
                        return;
                    }

                    const isExpanded = this.getAttribute('aria-expanded') === 'true';

                    detailRow.classList.toggle('hidden', isExpanded);
                    this.setAttribute('aria-expanded', String(!isExpanded));
                    this.textContent = isExpanded ? 'Dettaglio' : 'Chiudi';
                    this.classList.toggle('bg-indigo-600', !isExpanded);
                    this.classList.toggle('text-white', !isExpanded);
                    this.classList.toggle('border-indigo-600', !isExpanded);
                    this.classList.toggle('bg-indigo-50', isExpanded);
                    this.classList.toggle('text-indigo-600', isExpanded);
                    this.classList.toggle('border-indigo-200', isExpanded);
                });
            });
        });
    </script>
}
