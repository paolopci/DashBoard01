@using System.Globalization
@model DashboardOrders.Models.OrdersPageViewModel
@{
    ViewData["Title"] = "Ordini";
    var italianCulture = CultureInfo.GetCultureInfo("it-IT");
    var currentSortBy = Model.SortBy;
    var currentSortDirection = Model.SortDirection;
    var visiblePages = new List<int>();

    string FormatEuro(decimal value, string numericFormat = "N2")
    {
        return $"{value.ToString(numericFormat, italianCulture)} €";
    }

    string GetNextSortDirection(string column)
    {
        return currentSortBy == column && currentSortDirection == "asc" ? "desc" : "asc";
    }

    string GetSortArrow(string column)
    {
        if (currentSortBy != column)
        {
            return "↑↓";
        }

        return currentSortDirection == "asc" ? "↑" : "↓";
    }

    string GetSortLabelClass(string column)
    {
        return currentSortBy == column
            ? "font-bold text-slate-800"
            : "font-semibold text-slate-500";
    }

    if (!Model.ShowAll)
    {
        visiblePages.Add(1);

        for (var pageNumber = Math.Max(2, Model.CurrentPage - 1); pageNumber <= Math.Min(Model.TotalPages - 1, Model.CurrentPage + 1); pageNumber++)
        {
            if (!visiblePages.Contains(pageNumber))
            {
                visiblePages.Add(pageNumber);
            }
        }

        if (Model.TotalPages > 1 && !visiblePages.Contains(Model.TotalPages))
        {
            visiblePages.Add(Model.TotalPages);
        }

        visiblePages = visiblePages
            .Where(pageNumber => pageNumber >= 1 && pageNumber <= Model.TotalPages)
            .Distinct()
            .OrderBy(pageNumber => pageNumber)
            .ToList();
    }
}

<div class="mb-8">
    <h2 class="text-2xl font-bold text-slate-800">Ordini</h2>
    <p class="text-slate-500 mt-1">
        @if (Model.HasCustomerFilter)
        {
            <span>Visualizzazione filtrata sugli ordini del cliente <span class="font-semibold text-slate-700">@Model.SelectedCustomerName</span>.</span>
        }
        else
        {
            <span>Panoramica ordini con dettaglio di data, importo e stato per ogni registrazione.</span>
        }
    </p>
</div>

@if (Model.HasCustomerFilter)
{
    <div class="mb-6 flex flex-col gap-3 rounded-2xl border border-indigo-100 bg-indigo-50/70 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600">Filtro attivo</p>
            <p class="text-sm text-slate-600">Stai visualizzando solo gli ordini di <span class="font-semibold text-slate-800">@Model.SelectedCustomerName</span>.</p>
        </div>
        <a asp-action="Orders"
           asp-controller="Home"
           class="inline-flex items-center justify-center rounded-lg border border-indigo-200 bg-white px-4 py-2 text-sm font-semibold text-indigo-600 transition-colors hover:border-indigo-300 hover:text-indigo-700">
            Mostra tutti gli ordini
        </a>
    </div>
}

<div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3 mb-8">
    <div class="bg-white rounded-2xl shadow-sm p-6 flex items-center space-x-4 border border-slate-100 hover:shadow-md transition-shadow">
        <div class="h-14 w-14 rounded-xl bg-indigo-100 flex items-center justify-center shrink-0">
            <svg class="w-7 h-7 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
        </div>
        <div>
            <p class="text-sm font-medium text-slate-500">Ordini Totali</p>
            <p class="text-3xl font-bold text-slate-800">@Model.TotalOrders</p>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm p-6 flex items-center space-x-4 border border-slate-100 hover:shadow-md transition-shadow">
        <div class="h-14 w-14 rounded-xl bg-emerald-100 flex items-center justify-center shrink-0">
            <svg class="w-7 h-7 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <div>
            <p class="text-sm font-medium text-slate-500">Importo Totale</p>
            <p class="text-3xl font-bold text-slate-800">@FormatEuro(Model.TotalRevenue, "N0")</p>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm p-6 flex items-center space-x-4 border border-slate-100 hover:shadow-md transition-shadow md:col-span-2 xl:col-span-1">
        <div class="h-14 w-14 rounded-xl bg-amber-100 flex items-center justify-center shrink-0">
            <svg class="w-7 h-7 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <div class="space-y-1">
            <p class="text-sm font-medium text-slate-500">Stato Ordini</p>
            <div class="flex flex-wrap items-center gap-2 text-sm font-semibold">
                <span class="inline-flex items-center rounded-full bg-amber-50 px-3 py-1 text-amber-700">@Model.PendingOrders in lavorazione</span>
                <span class="inline-flex items-center rounded-full bg-blue-50 px-3 py-1 text-blue-700"
                      style="margin-left: 0.5rem;">@Model.ShippedOrders evasi</span>
            </div>
        </div>
    </div>
</div>

<div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
    <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between">
        <h3 class="text-lg font-semibold text-slate-800">Elenco Ordini</h3>
        <span class="text-sm text-slate-500">Totale: @Model.TotalOrders ordini</span>
    </div>
    <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/70 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <form method="get" asp-action="Orders" asp-controller="Home" class="flex items-center gap-3">
            <label for="pageSize" class="text-sm font-medium text-slate-600">Elementi per pagina</label>
            <select id="pageSize"
                    name="pageSize"
                    onchange="this.form.submit()"
                    class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200">
                @if (Model.PageSize == 10)
                {
                    <option value="10" selected>10</option>
                }
                else
                {
                    <option value="10">10</option>
                }

                @if (Model.PageSize == 20)
                {
                    <option value="20" selected>20</option>
                }
                else
                {
                    <option value="20">20</option>
                }

                @if (Model.PageSize == 50)
                {
                    <option value="50" selected>50</option>
                }
                else
                {
                    <option value="50">50</option>
                }

                @if (Model.ShowAll)
                {
                    <option value="0" selected>All</option>
                }
                else
                {
                    <option value="0">All</option>
                }
            </select>
            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="sortBy" value="@Model.SortBy" />
            <input type="hidden" name="sortDirection" value="@Model.SortDirection" />
            @if (Model.HasCustomerFilter)
            {
                <input type="hidden" name="customerId" value="@Model.SelectedCustomerId" />
            }
        </form>

        <div class="text-sm text-slate-500">
            @if (Model.ShowAll)
            {
                <span>Tutti gli ordini in una sola pagina</span>
            }
            else
            {
                <span>Pagina @Model.CurrentPage di @Model.TotalPages</span>
            }
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full">
            <thead>
                <tr class="bg-slate-50 border-b border-slate-100">
                    <th class="px-6 py-4 text-left">
                        <a asp-action="Orders"
                           asp-controller="Home"
                           asp-route-page="1"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-customerId="@Model.SelectedCustomerId"
                           asp-route-sortBy="orderNumber"
                           asp-route-sortDirection="@GetNextSortDirection("orderNumber")"
                           class="inline-flex items-center gap-2 text-xs uppercase tracking-wider transition-colors hover:text-indigo-600 @GetSortLabelClass("orderNumber")">
                            <span>N# Ordine</span>
                            <span class="text-sm text-indigo-600">@GetSortArrow("orderNumber")</span>
                        </a>
                    </th>
                    <th class="px-6 py-4 text-left">
                        <a asp-action="Orders"
                           asp-controller="Home"
                           asp-route-page="1"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-customerId="@Model.SelectedCustomerId"
                           asp-route-sortBy="date"
                           asp-route-sortDirection="@GetNextSortDirection("date")"
                           class="inline-flex items-center gap-2 text-xs uppercase tracking-wider transition-colors hover:text-indigo-600 @GetSortLabelClass("date")">
                            <span>Data</span>
                            <span class="text-sm text-indigo-600">@GetSortArrow("date")</span>
                        </a>
                    </th>
                    <th class="px-6 py-4 text-right">
                        <a asp-action="Orders"
                           asp-controller="Home"
                           asp-route-page="1"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-customerId="@Model.SelectedCustomerId"
                           asp-route-sortBy="amount"
                           asp-route-sortDirection="@GetNextSortDirection("amount")"
                           class="inline-flex items-center justify-end gap-2 text-xs uppercase tracking-wider transition-colors hover:text-indigo-600 @GetSortLabelClass("amount")">
                            <span>Importo</span>
                            <span class="text-sm text-indigo-600">@GetSortArrow("amount")</span>
                        </a>
                    </th>
                    <th class="px-6 py-4 text-center">
                        <a asp-action="Orders"
                           asp-controller="Home"
                           asp-route-page="1"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-customerId="@Model.SelectedCustomerId"
                           asp-route-sortBy="status"
                           asp-route-sortDirection="@GetNextSortDirection("status")"
                           class="inline-flex items-center justify-center gap-2 text-xs uppercase tracking-wider transition-colors hover:text-indigo-600 @GetSortLabelClass("status")">
                            <span>Stato</span>
                            <span class="text-sm text-indigo-600">@GetSortArrow("status")</span>
                        </a>
                    </th>
                    <th class="text-center text-xs font-semibold text-slate-500 uppercase tracking-wider px-6 py-4">Dett. Ordine</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-50">
                @foreach (var order in Model.Orders)
                {
                    var (rowAccent, bgColor, color, label) = order.Status switch
                    {
                        DashboardOrders.Models.OrderStatus.Delivered => ("bg-emerald-500", "#d1fae5", "#065f46", "Consegnato"),
                        DashboardOrders.Models.OrderStatus.Shipped => ("bg-blue-500", "#dbeafe", "#1e40af", "Spedito"),
                        DashboardOrders.Models.OrderStatus.Processing => ("bg-indigo-500", "#e0e7ff", "#3730a3", "Elaborazione"),
                        DashboardOrders.Models.OrderStatus.Pending => ("bg-amber-500", "#fef3c7", "#92400e", "In Attesa"),
                        DashboardOrders.Models.OrderStatus.Cancelled => ("bg-rose-500", "#fee2e2", "#991b1b", "Annullato"),
                        _ => ("bg-slate-400", "#f1f5f9", "#475569", "Sconosciuto")
                    };
                    var detailRowId = $"order-detail-{order.Id}";
                    var detailButtonId = $"order-detail-button-{order.Id}";

                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-4">
                                <span class="h-10 w-1.5 rounded-full @rowAccent"></span>
                                <div>
                                    <p class="text-sm font-semibold text-indigo-600">@order.OrderNumber</p>
                                    <p class="text-xs text-slate-400">@order.Customer.Name</p>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4 text-sm text-slate-600">@order.OrderDate.ToString("dd/MM/yyyy")</td>
                        <td class="px-6 py-4 text-right text-sm font-semibold text-slate-800">@FormatEuro(order.TotalAmount)</td>
                        <td class="px-6 py-4 text-center">
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold"
                                  style="background-color: @bgColor; color: @color;">
                                @label
                            </span>
                        </td>
                        <td class="px-6 py-4 text-center">
                            <button type="button"
                                    id="@detailButtonId"
                                    class="order-detail-toggle inline-flex items-center rounded-lg border border-indigo-200 bg-indigo-50 px-4 py-2 text-sm font-semibold text-indigo-600 transition-colors hover:border-indigo-300 hover:bg-indigo-100 hover:text-indigo-700"
                                    data-target="@detailRowId"
                                    aria-expanded="false"
                                    aria-controls="@detailRowId">
                                Dettaglio
                            </button>
                        </td>
                    </tr>
                    <tr id="@detailRowId" class="order-detail-row hidden bg-slate-50/80">
                        <td colspan="5" class="px-6 pb-6 pt-2">
                            <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                                <div class="border-b border-amber-200 bg-amber-100 px-5 py-4"
                                     style="padding-left: 2rem; padding-right: 2rem;">
                                    <div class="flex flex-wrap items-center gap-x-8 gap-y-2 text-sm"
                                         style="display: flex; flex-wrap: wrap; align-items: center; column-gap: 2rem; row-gap: 0.5rem;">
                                        <p class="font-semibold text-slate-800">Dettaglio ordine @order.OrderNumber</p>
                                        <p class="text-slate-500">Numero articoli: <span class="font-semibold text-slate-700">@order.ItemsCount</span></p>
                                        <p class="text-slate-500">Pezzi Totali: <span class="font-semibold text-slate-700">@order.Quantity</span></p>
                                        <p class="text-slate-500">Cliente: <span class="font-semibold text-slate-700">@order.Customer.Name</span></p>
                                    </div>
                                </div>
                                <div class="overflow-x-auto">
                                    <table class="w-full min-w-[640px]">
                                        <thead>
                                            <tr class="border-b border-slate-100 bg-white">
                                                <th class="pl-8 pr-5 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"
                                                    style="padding-left: 2rem;">Articolo</th>
                                                <th class="px-5 py-3 text-center text-xs font-semibold uppercase tracking-wider text-slate-500">Qtà</th>
                                                <th class="px-5 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">Prezzo Unitario</th>
                                                <th class="pl-5 pr-8 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500"
                                                    style="padding-right: 2rem;">Totale Riga</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-100">
                                            @foreach (var item in order.Items)
                                            {
                                                <tr class="transition-colors hover:bg-slate-50">
                                                    <td class="pl-8 pr-5 py-3 text-sm font-medium text-slate-700"
                                                        style="padding-left: 2rem;">@item.ProductName</td>
                                                    <td class="px-5 py-3 text-center text-sm text-slate-600">@item.Quantity</td>
                                                    <td class="px-5 py-3 text-right text-sm text-slate-600">@FormatEuro(item.UnitPrice)</td>
                                                    <td class="pl-5 pr-8 py-3 text-right text-sm font-semibold text-slate-800"
                                                        style="padding-right: 2rem;">@FormatEuro(item.TotalPrice)</td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr class="border-t border-slate-200 bg-slate-50">
                                                <td colspan="3" class="px-5 py-4 text-right text-sm font-semibold uppercase tracking-wide text-slate-500">Totale Ordine</td>
                                                <td class="pl-5 pr-8 py-4 text-right text-base font-bold text-slate-800"
                                                    style="padding-right: 2rem;">@FormatEuro(order.TotalAmount)</td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="px-6 py-4 border-t border-slate-100 bg-white flex flex-col gap-4">
        <div class="text-sm text-slate-500">
            @if (Model.ShowAll)
            {
                <span>Visualizzati @Model.TotalOrders di @Model.TotalOrders ordini</span>
            }
            else
            {
                <span>Visualizzati @Model.Orders.Count ordini su @Model.TotalOrders</span>
            }
        </div>

        @if (!Model.ShowAll)
        {
            <div class="w-full rounded-2xl border border-slate-200 bg-slate-50/80 px-4 py-3 shadow-sm">
                <div class="grid gap-4 lg:grid-cols-[1fr_auto_1fr] lg:items-center">
                    <div class="hidden lg:block"></div>

                    <nav class="flex flex-wrap items-center justify-center gap-3" aria-label="Paginazione ordini">
                        <a asp-action="Orders"
                           asp-controller="Home"
                           asp-route-page="1"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-customerId="@Model.SelectedCustomerId"
                           asp-route-sortBy="@Model.SortBy"
                           asp-route-sortDirection="@Model.SortDirection"
                           class="inline-flex h-11 min-w-11 items-center justify-center rounded-xl border bg-white px-4 text-base font-semibold shadow-sm transition-colors @(Model.HasPreviousPage ? "border-slate-200 text-slate-600 hover:border-indigo-200 hover:text-indigo-600" : "border-slate-100 text-slate-300 pointer-events-none")">
                            &lt;&lt;
                        </a>
                        <a asp-action="Orders"
                           asp-controller="Home"
                           asp-route-page="@Model.PreviousPage"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-customerId="@Model.SelectedCustomerId"
                           asp-route-sortBy="@Model.SortBy"
                           asp-route-sortDirection="@Model.SortDirection"
                           class="inline-flex h-11 min-w-11 items-center justify-center rounded-xl border bg-white px-4 text-base font-semibold shadow-sm transition-colors @(Model.HasPreviousPage ? "border-slate-200 text-slate-600 hover:border-indigo-200 hover:text-indigo-600" : "border-slate-100 text-slate-300 pointer-events-none")">
                            &lt;
                        </a>

                        @{
                            int? previousRenderedPage = null;
                        }

                        @foreach (var pageNumber in visiblePages)
                        {
                            if (previousRenderedPage.HasValue && pageNumber - previousRenderedPage.Value > 1)
                            {
                                <span class="inline-flex h-11 min-w-11 items-center justify-center px-2 text-base font-semibold text-slate-400">...</span>
                            }

                            if (pageNumber == Model.CurrentPage)
                            {
                                <span class="inline-flex h-11 min-w-11 items-center justify-center rounded-xl bg-indigo-500 px-4 text-base font-semibold text-white shadow-md shadow-indigo-500/30">
                                    @pageNumber
                                </span>
                            }
                            else
                            {
                                <a asp-action="Orders"
                                   asp-controller="Home"
                                   asp-route-page="@pageNumber"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-customerId="@Model.SelectedCustomerId"
                                   asp-route-sortBy="@Model.SortBy"
                                   asp-route-sortDirection="@Model.SortDirection"
                                   class="inline-flex h-11 min-w-11 items-center justify-center rounded-xl border border-slate-200 bg-white px-4 text-base font-semibold text-slate-600 shadow-sm transition-colors hover:border-indigo-200 hover:text-indigo-600">
                                    @pageNumber
                                </a>
                            }

                            previousRenderedPage = pageNumber;
                        }

                        <a asp-action="Orders"
                           asp-controller="Home"
                           asp-route-page="@Model.NextPage"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-customerId="@Model.SelectedCustomerId"
                           asp-route-sortBy="@Model.SortBy"
                           asp-route-sortDirection="@Model.SortDirection"
                           class="inline-flex h-11 min-w-11 items-center justify-center rounded-xl border bg-white px-4 text-base font-semibold shadow-sm transition-colors @(Model.HasNextPage ? "border-slate-200 text-slate-600 hover:border-indigo-200 hover:text-indigo-600" : "border-slate-100 text-slate-300 pointer-events-none")">
                            &gt;
                        </a>
                        <a asp-action="Orders"
                           asp-controller="Home"
                           asp-route-page="@Model.TotalPages"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-customerId="@Model.SelectedCustomerId"
                           asp-route-sortBy="@Model.SortBy"
                           asp-route-sortDirection="@Model.SortDirection"
                           class="inline-flex h-11 min-w-11 items-center justify-center rounded-xl border bg-white px-4 text-base font-semibold shadow-sm transition-colors @(Model.HasNextPage ? "border-slate-200 text-slate-600 hover:border-indigo-200 hover:text-indigo-600" : "border-slate-100 text-slate-300 pointer-events-none")">
                            &gt;&gt;
                        </a>
                    </nav>

                    <div class="flex items-center justify-center gap-3 text-sm text-slate-500 lg:justify-end">
                        <span class="text-lg font-medium text-slate-600">Page</span>
                        <form method="get" asp-action="Orders" asp-controller="Home" class="flex items-center gap-2">
                            <input type="hidden" name="pageSize" value="@Model.PageSize" />
                            <input type="hidden" name="sortBy" value="@Model.SortBy" />
                            <input type="hidden" name="sortDirection" value="@Model.SortDirection" />
                            @if (Model.HasCustomerFilter)
                            {
                                <input type="hidden" name="customerId" value="@Model.SelectedCustomerId" />
                            }
                            <select id="page"
                                    name="page"
                                    onchange="this.form.submit()"
                                    class="h-11 min-w-20 rounded-xl border border-slate-200 bg-white px-4 text-base font-semibold text-slate-700 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200">
                                @for (var pageNumberOption = 1; pageNumberOption <= Model.TotalPages; pageNumberOption++)
                                {
                                    if (pageNumberOption == Model.CurrentPage)
                                    {
                                        <option value="@pageNumberOption" selected>@pageNumberOption</option>
                                    }
                                    else
                                    {
                                        <option value="@pageNumberOption">@pageNumberOption</option>
                                    }
                                }
                            </select>
                        </form>
                        <span class="text-lg">of @Model.TotalPages</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const detailButtons = document.querySelectorAll('.order-detail-toggle');

            detailButtons.forEach(button => {
                button.addEventListener('click', function () {
                    const targetId = this.getAttribute('data-target');
                    const detailRow = document.getElementById(targetId);

                    if (!detailRow) {
                        return;
                    }

                    const isExpanded = this.getAttribute('aria-expanded') === 'true';

                    detailRow.classList.toggle('hidden', isExpanded);
                    this.setAttribute('aria-expanded', String(!isExpanded));
                    this.textContent = isExpanded ? 'Dettaglio' : 'Chiudi';
                    this.classList.toggle('bg-indigo-600', !isExpanded);
                    this.classList.toggle('text-white', !isExpanded);
                    this.classList.toggle('border-indigo-600', !isExpanded);
                    this.classList.toggle('bg-indigo-50', isExpanded);
                    this.classList.toggle('text-indigo-600', isExpanded);
                    this.classList.toggle('border-indigo-200', isExpanded);
                });
            });
        });
    </script>
}
