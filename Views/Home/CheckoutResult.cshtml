@model DashboardOrders.Models.OrderDetailsViewModel
@{
    ViewData["Title"] = "Esito checkout";
    var status = OrderStatusPresentation.FromStatus(Model.Order.Status);
}

<div class="mx-auto max-w-3xl rounded-2xl border border-slate-100 bg-white p-6 text-center shadow-sm">
    <span class="inline-flex rounded-full px-4 py-2 text-sm font-semibold" style="background-color: @status.BackgroundColor; color: @status.ForegroundColor;">@status.Label</span>
    <h2 class="mt-5 text-3xl font-bold text-slate-900">Ordine @Model.Order.OrderNumber</h2>
    <p class="mt-2 text-sm text-slate-500">Il checkout e stato registrato. Esito pagamento test: @(Model.CheckoutDetails?.PaymentStatus ?? "non disponibile").</p>
    <p class="mt-5 text-2xl font-bold text-slate-900">@FormatEuro(Model.Order.TotalAmount)</p>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-center">
        <a asp-controller="Home" asp-action="OrderDetails" asp-route-id="@Model.Order.Id" class="inline-flex items-center justify-center rounded-lg bg-indigo-600 px-5 py-2 text-sm font-semibold text-white">Dettaglio ordine</a>
        <a asp-controller="Home" asp-action="Orders" class="inline-flex items-center justify-center rounded-lg border border-slate-200 px-5 py-2 text-sm font-semibold text-slate-700">Elenco ordini</a>
    </div>
</div>
