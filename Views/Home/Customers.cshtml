@model DashboardOrders.Models.CustomersPageViewModel
@{
    ViewData["Title"] = "Clienti";
    var currentSortBy = Model.SortBy;
    var currentSortDirection = Model.SortDirection;

    Dictionary<string, string> CustomerRouteValues()
    {
        return new Dictionary<string, string>
        {
            ["search"] = Model.SearchTerm
        };
    }

    SortableHeaderViewModel CustomerHeader(string column, string label, string alignment = "left")
    {
        return new SortableHeaderViewModel
        {
            ActionName = "Customers",
            ControllerName = "Home",
            Column = column,
            Label = label,
            CurrentSortBy = currentSortBy,
            CurrentSortDirection = currentSortDirection,
            PageSize = Model.PageSize,
            Alignment = alignment,
            ExtraRouteValues = CustomerRouteValues()
        };
    }
}

<div class="mb-8">
    <h2 class="text-2xl font-bold text-slate-800">Clienti</h2>
    <p class="text-slate-500 mt-1">
        @if (Model.HasActiveSearch)
        {
            <span>Risultati filtro per <span class="font-semibold text-slate-700">"@Model.SearchTerm"</span>.</span>
        }
        else
        {
            <span>Panoramica clienti con numero ordini effettuati e importo totale generato.</span>
        }
    </p>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6 mb-8">
    <div class="bg-white rounded-2xl shadow-sm p-6 flex items-center space-x-4 border border-slate-100 hover:shadow-md transition-shadow">
        <div class="h-14 w-14 rounded-xl bg-purple-100 flex items-center justify-center shrink-0">
            <svg class="w-7 h-7 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
        </div>
        <div>
            <p class="text-sm font-medium text-slate-500">Clienti Totali</p>
            <p class="text-3xl font-bold text-slate-800">@Model.TotalCustomers</p>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm p-6 flex items-center space-x-4 border border-slate-100 hover:shadow-md transition-shadow">
        <div class="h-14 w-14 rounded-xl bg-indigo-100 flex items-center justify-center shrink-0">
            <svg class="w-7 h-7 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
        </div>
        <div>
            <p class="text-sm font-medium text-slate-500">Clienti con Ordini</p>
            <p class="text-3xl font-bold text-slate-800">@Model.CustomersWithOrders</p>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm p-6 flex items-center justify-between gap-4 border border-slate-100 hover:shadow-md transition-shadow sm:col-span-2 xl:col-span-1">
        <div class="h-14 w-14 rounded-xl bg-emerald-100 flex items-center justify-center shrink-0">
            <span class="text-3xl font-bold leading-none text-emerald-600">€</span>
        </div>
        <div class="ml-auto text-right">
            <p class="text-sm font-medium text-slate-500">Importo Totale Ordini</p>
            <p class="text-3xl font-bold text-slate-800">@FormatEuro(Model.TotalRevenue)</p>
        </div>
    </div>
</div>

<div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
    @if (Model.Customers.Any())
    {
        <div class="px-6 py-5 border-b border-slate-100">
            <h3 class="text-lg font-semibold text-slate-800">Elenco Clienti</h3>
        </div>
        <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/70 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <partial name="_PageSizeSelector" model="@(new PageSizeSelectorViewModel
            {
                ActionName = "Customers",
                ControllerName = "Home",
                PageSize = Model.PageSize,
                SortBy = Model.SortBy,
                SortDirection = Model.SortDirection,
                ExtraRouteValues = CustomerRouteValues()
            })" />

            <div class="text-sm text-slate-500">
                @if (Model.ShowAll)
                {
                    <span>Tutti i clienti in una sola pagina</span>
                }
                else
                {
                    <span>Pagina @Model.CurrentPage di @Model.TotalPages</span>
                }
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-100">
                        <th class="px-6 py-3 text-center">
                            <partial name="_SortableHeader" model='@CustomerHeader("customer", "Clienti", "center")' />
                        </th>
                        <th class="px-6 py-3 text-center">
                            <partial name="_SortableHeader" model='@CustomerHeader("ordersCount", "Numero Ordini", "center")' />
                        </th>
                        <th class="px-6 py-3 text-right">
                            <partial name="_SortableHeader" model='@CustomerHeader("totalAmount", "Importo Totale Ordini", "right")' />
                        </th>
                        <th class="px-6 py-3 text-center">
                            <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Ordini</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    @foreach (var customerSummary in Model.Customers)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4">
                                <div class="flex items-center space-x-3">
                                    <div class="h-10 w-10 rounded-full bg-gradient-to-br from-indigo-400 to-purple-500 text-white text-xs font-bold flex items-center justify-center shrink-0">
                                        @customerSummary.Customer.AvatarInitials
                                    </div>
                                    <div>
                                        <p class="text-sm font-medium text-slate-800">@customerSummary.Customer.Name</p>
                                        <p class="text-xs text-slate-400">@customerSummary.Customer.Email</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-center">
                                <span class="inline-flex min-w-10 items-center justify-center rounded-full bg-indigo-50 px-3 py-1 text-sm font-semibold text-indigo-700">
                                    @customerSummary.OrdersCount
                                </span>
                            </td>
                            <td class="px-6 py-4 text-sm font-semibold text-slate-800 text-right">
                                @FormatEuro(customerSummary.TotalOrdersAmount)
                            </td>
                            <td class="px-6 py-4 text-center">
                                @if (customerSummary.OrdersCount > 0)
                                {
                                    <a asp-action="Orders"
                                       asp-controller="Home"
                                       asp-route-customerId="@customerSummary.Customer.Id"
                                       class="inline-flex items-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm shadow-indigo-600/20 transition-colors hover:bg-indigo-700">
                                        Ordini
                                    </a>
                                }
                                else
                                {
                                    <span class="inline-flex items-center rounded-lg bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-400">
                                        Ordini
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pagination" model="@(new PaginationViewModel
        {
            ActionName = "Customers",
            ControllerName = "Home",
            EntityLabel = "clienti",
            CurrentPage = Model.CurrentPage,
            PageSize = Model.PageSize,
            TotalPages = Model.TotalPages,
            TotalItems = Model.TotalCustomers,
            DisplayedItems = Model.Customers.Count,
            SortBy = Model.SortBy,
            SortDirection = Model.SortDirection,
            ExtraRouteValues = CustomerRouteValues()
        })" />
    }
    else if (Model.HasActiveSearch)
    {
        <div class="flex min-h-[280px] items-center justify-center px-6 py-16">
            <p class="text-center text-2xl font-bold text-slate-700">Nessun Cliente Trovato</p>
        </div>
    }
</div>
