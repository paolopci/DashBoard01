@model Logout
@{
    ViewData["Title"] = "Logout";
}

<div class="mx-auto max-w-xl">
    <div class="mb-8">
        <h2 class="text-2xl font-bold text-slate-800">Esci</h2>
        <p class="mt-1 text-slate-500">Conferma il logout dalla dashboard.</p>
    </div>

    <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
        <p class="text-sm text-slate-600">La sessione corrente verrà chiusa.</p>

        <form method="post" asp-action="Logout" class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
            <input type="hidden" asp-for="ReturnUrl" />
            <button type="submit" class="inline-flex justify-center rounded-lg bg-rose-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-rose-700">
                Esci
            </button>
            <a asp-controller="Home" asp-action="Index" class="inline-flex justify-center rounded-lg border border-slate-200 bg-white px-6 py-2.5 text-sm font-semibold text-slate-600 shadow-sm transition-colors hover:border-indigo-200 hover:text-indigo-600">
                Annulla
            </a>
        </form>
    </div>
</div>
