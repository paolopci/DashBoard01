@model Register
@{
    ViewData["Title"] = "Registrazione";
}

<div class="mx-auto max-w-4xl">
    <div class="mb-8">
        <h2 class="text-2xl font-bold text-slate-800">Crea account</h2>
        <p class="mt-1 text-slate-500">Inserisci i dati richiesti per accedere alla dashboard.</p>
    </div>

    <div class="overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm">
        <div class="border-b border-slate-100 px-6 py-5">
            <h3 class="text-lg font-semibold text-slate-800">Dati account</h3>
        </div>
        <div class="p-6">
            <form method="post" asp-action="Register" class="space-y-6">
                <div asp-validation-summary="ModelOnly" class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700"></div>

                <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                    <div>
                        <label asp-for="FirstName" class="mb-2 block text-sm font-medium text-slate-700"></label>
                        <input asp-for="FirstName" autocomplete="given-name" class="w-full rounded-lg border border-slate-200 px-4 py-2.5 text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" />
                        <span asp-validation-for="FirstName" class="mt-1 block text-sm text-rose-600"></span>
                    </div>

                    <div>
                        <label asp-for="LastName" class="mb-2 block text-sm font-medium text-slate-700"></label>
                        <input asp-for="LastName" autocomplete="family-name" class="w-full rounded-lg border border-slate-200 px-4 py-2.5 text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" />
                        <span asp-validation-for="LastName" class="mt-1 block text-sm text-rose-600"></span>
                    </div>

                    <div>
                        <label asp-for="Email" class="mb-2 block text-sm font-medium text-slate-700"></label>
                        <input asp-for="Email" autocomplete="email" class="w-full rounded-lg border border-slate-200 px-4 py-2.5 text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" />
                        <span asp-validation-for="Email" class="mt-1 block text-sm text-rose-600"></span>
                    </div>

                    <div>
                        <label asp-for="DateOfBirth" class="mb-2 block text-sm font-medium text-slate-700"></label>
                        <input asp-for="DateOfBirth" class="w-full rounded-lg border border-slate-200 px-4 py-2.5 text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" />
                        <span asp-validation-for="DateOfBirth" class="mt-1 block text-sm text-rose-600"></span>
                    </div>

                    <div>
                        <label asp-for="City" class="mb-2 block text-sm font-medium text-slate-700"></label>
                        <input asp-for="City" autocomplete="address-level2" class="w-full rounded-lg border border-slate-200 px-4 py-2.5 text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" />
                        <span asp-validation-for="City" class="mt-1 block text-sm text-rose-600"></span>
                    </div>

                    <div>
                        <label asp-for="Country" class="mb-2 block text-sm font-medium text-slate-700"></label>
                        <input asp-for="Country" autocomplete="country-name" class="w-full rounded-lg border border-slate-200 px-4 py-2.5 text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" />
                        <span asp-validation-for="Country" class="mt-1 block text-sm text-rose-600"></span>
                    </div>

                    <div>
                        <label asp-for="Cap" class="mb-2 block text-sm font-medium text-slate-700"></label>
                        <input asp-for="Cap" autocomplete="off" maxlength="16" class="w-full rounded-lg border border-slate-200 px-4 py-2.5 uppercase text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" />
                        <span asp-validation-for="Cap" class="mt-1 block text-sm text-rose-600"></span>
                    </div>

                    <div>
                        <label asp-for="Password" class="mb-2 block text-sm font-medium text-slate-700"></label>
                        <input asp-for="Password" autocomplete="new-password" class="w-full rounded-lg border border-slate-200 px-4 py-2.5 text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" />
                        <span asp-validation-for="Password" class="mt-1 block text-sm text-rose-600"></span>
                    </div>

                    <div>
                        <label asp-for="RepeatPassword" class="mb-2 block text-sm font-medium text-slate-700"></label>
                        <input asp-for="RepeatPassword" autocomplete="new-password" class="w-full rounded-lg border border-slate-200 px-4 py-2.5 text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" />
                        <span asp-validation-for="RepeatPassword" class="mt-1 block text-sm text-rose-600"></span>
                    </div>
                </div>

                <div class="flex flex-col gap-3 border-t border-slate-100 pt-6 sm:flex-row sm:items-center">
                    <button type="submit" class="inline-flex justify-center rounded-lg bg-indigo-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-indigo-700">
                        Crea account
                    </button>
                    <a asp-action="Login" class="inline-flex justify-center rounded-lg border border-slate-200 bg-white px-6 py-2.5 text-sm font-semibold text-slate-600 shadow-sm transition-colors hover:border-indigo-200 hover:text-indigo-600">
                        Ho già un account
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
