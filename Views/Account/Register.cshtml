@model Register
@{
    ViewData["Title"] = "Registrazione";
}

<div class="mx-auto max-w-4xl">
    <div class="mb-8">
        <h2 class="text-2xl font-bold text-slate-800">Crea account</h2>
        <p class="mt-1 text-slate-500">Inserisci i dati richiesti per accedere alla dashboard.</p>
    </div>

    <div class="overflow-hidden rounded-lg border border-slate-100 bg-white shadow-sm">
        <div class="flex flex-col gap-2 border-b border-slate-100 px-6 py-5 sm:flex-row sm:items-center sm:justify-between">
            <h3 class="text-lg font-semibold text-slate-800">Dati account</h3>
            <span class="text-sm font-bold text-rose-600">* campi obbligatori</span>
        </div>
        <div class="p-6">
            <form method="post" asp-action="Register" class="space-y-6" data-register-form>
                <div asp-validation-summary="ModelOnly" class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700"></div>

                <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                    <div>
                        <label asp-for="FirstName" class="mb-2 block text-sm font-medium text-slate-700">Nome *</label>
                        <input asp-for="FirstName" autocomplete="given-name" data-register-required class="w-full rounded-lg border border-slate-200 px-4 py-2.5 text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" />
                        <span asp-validation-for="FirstName" class="mt-1 block text-sm text-rose-600"></span>
                    </div>

                    <div>
                        <label asp-for="LastName" class="mb-2 block text-sm font-medium text-slate-700">Cognome *</label>
                        <input asp-for="LastName" autocomplete="family-name" data-register-required class="w-full rounded-lg border border-slate-200 px-4 py-2.5 text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" />
                        <span asp-validation-for="LastName" class="mt-1 block text-sm text-rose-600"></span>
                    </div>

                    <div>
                        <label asp-for="Email" class="mb-2 block text-sm font-medium text-slate-700">Email *</label>
                        <input asp-for="Email" autocomplete="email" data-register-required class="w-full rounded-lg border border-slate-200 px-4 py-2.5 text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" />
                        <span asp-validation-for="Email" class="mt-1 block text-sm text-rose-600"></span>
                    </div>

                    <div>
                        <label asp-for="DateOfBirth" class="mb-2 block text-sm font-medium text-slate-700">Data di nascita *</label>
                        <input asp-for="DateOfBirth" data-register-required class="w-full rounded-lg border border-slate-200 px-4 py-2.5 text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" />
                        <span asp-validation-for="DateOfBirth" class="mt-1 block text-sm text-rose-600"></span>
                    </div>

                    <div>
                        <label asp-for="City" class="mb-2 block text-sm font-medium text-slate-700">Città *</label>
                        <input asp-for="City" autocomplete="address-level2" data-register-required class="w-full rounded-lg border border-slate-200 px-4 py-2.5 text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" />
                        <span asp-validation-for="City" class="mt-1 block text-sm text-rose-600"></span>
                    </div>

                    <div>
                        <label asp-for="Country" class="mb-2 block text-sm font-medium text-slate-700">Paese *</label>
                        <input asp-for="Country" autocomplete="country-name" data-register-required class="w-full rounded-lg border border-slate-200 px-4 py-2.5 text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" />
                        <span asp-validation-for="Country" class="mt-1 block text-sm text-rose-600"></span>
                    </div>

                                        <div class="md:col-span-2">
                        <label asp-for="Cap" class="mb-2 block text-sm font-medium text-slate-700">Codice fiscale *</label>
                        <input asp-for="Cap" autocomplete="off" maxlength="16" data-register-required class="w-full rounded-lg border border-slate-200 px-4 py-2.5 uppercase text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" />
                        <span asp-validation-for="Cap" class="mt-1 block text-sm text-rose-600"></span>
                    </div>

                    <div class="md:col-span-2">
                        <label class="mb-2 block text-sm font-medium text-slate-700">Telefono *</label>
                        <div class="grid grid-cols-1 gap-3 sm:grid-cols-[12rem_1fr]">
                            <div class="relative" data-phone-prefix-combobox>
                                <input asp-for="PhonePrefix" type="hidden" data-phone-prefix-value data-register-required />
                                <input asp-for="PhoneCountryIso2" type="hidden" data-phone-country-iso2 />
                                <button type="button" class="flex min-h-[2.625rem] w-full items-center justify-between gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-left focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" role="combobox" aria-haspopup="listbox" aria-expanded="false" data-phone-prefix-toggle>
                                    <span class="flex min-w-0 items-center gap-2">
                                        <img alt="" class="h-4 w-6 shrink-0 rounded-sm object-cover ring-1 ring-slate-200" data-phone-prefix-flag hidden />
                                        <span class="truncate" data-phone-prefix-label>Prefisso</span>
                                    </span>
                                    <span class="shrink-0 text-slate-400" aria-hidden="true">▾</span>
                                </button>
                                <div class="absolute z-30 mt-1 hidden max-h-72 w-[min(24rem,calc(100vw-2rem))] overflow-hidden rounded-lg border border-slate-200 bg-white shadow-lg" data-phone-prefix-panel>
                                    <div class="border-b border-slate-100 p-2">
                                        <input type="search" class="w-full rounded-lg border border-slate-200 px-4 py-2.5 text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" placeholder="Cerca paese o prefisso" autocomplete="off" data-phone-prefix-search />
                                    </div>
                                    <div class="max-h-56 overflow-y-auto py-1" role="listbox" data-phone-prefix-options></div>
                                </div>
                            </div>
                            <div>
                                <input asp-for="PhoneNumber" autocomplete="tel-national" data-register-required class="w-full rounded-lg border border-slate-200 px-4 py-2.5 text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" placeholder="Numero di telefono" />
                            </div>
                        </div>
                        <span asp-validation-for="PhonePrefix" class="mt-1 block text-sm text-rose-600"></span>
                        <span asp-validation-for="PhoneNumber" class="mt-1 block text-sm text-rose-600"></span>
                    </div>

                    <div>
                        <label asp-for="Password" class="mb-2 block text-sm font-medium text-slate-700">Password *</label>
                        <input asp-for="Password" autocomplete="new-password" data-register-required class="w-full rounded-lg border border-slate-200 px-4 py-2.5 text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" />
                        <span asp-validation-for="Password" class="mt-1 block text-sm text-rose-600"></span>
                    </div>

                    <div>
                        <label asp-for="RepeatPassword" class="mb-2 block text-sm font-medium text-slate-700">Ripeti password *</label>
                        <input asp-for="RepeatPassword" autocomplete="new-password" data-register-required class="w-full rounded-lg border border-slate-200 px-4 py-2.5 text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" />
                        <span asp-validation-for="RepeatPassword" class="mt-1 block text-sm text-rose-600"></span>
                    </div>
                </div>

                <div class="flex flex-col gap-3 border-t border-slate-100 pt-6 sm:flex-row sm:items-center">
                    <button type="submit" data-register-submit disabled class="inline-flex justify-center rounded-lg bg-indigo-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-indigo-700 disabled:cursor-not-allowed disabled:bg-slate-300 disabled:text-slate-500 disabled:shadow-none">
                        Crea account
                    </button>
                    <a asp-action="Login" class="inline-flex justify-center rounded-lg border border-slate-200 bg-white px-6 py-2.5 text-sm font-semibold text-slate-600 shadow-sm transition-colors hover:border-indigo-200 hover:text-indigo-600">
                        Ho già un account
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const form = document.querySelector('[data-register-form]');
            if (!form) return;

            const endpoints = {
                phonePrefixes: '@Url.Action("PhoneCountryPrefixes", "Home")'
            };

            const phonePrefixCombobox = form.querySelector('[data-phone-prefix-combobox]');
            const phonePrefixValue = form.querySelector('[data-phone-prefix-value]');
            const phoneCountryIso2 = form.querySelector('[data-phone-country-iso2]');
            const phonePrefixToggle = form.querySelector('[data-phone-prefix-toggle]');
            const phonePrefixPanel = form.querySelector('[data-phone-prefix-panel]');
            const phonePrefixSearch = form.querySelector('[data-phone-prefix-search]');
            const phonePrefixOptions = form.querySelector('[data-phone-prefix-options]');
            const phonePrefixFlag = form.querySelector('[data-phone-prefix-flag]');
            const phonePrefixLabel = form.querySelector('[data-phone-prefix-label]');
            let phoneCountryPrefixes = [];

            const fetchJson = async (url) => {
                const response = await fetch(url);
                if (!response.ok) return [];
                return response.json();
            };

            const getSelectedPhonePrefix = () => {
                const iso2 = phoneCountryIso2?.value || '';
                const dialCode = phonePrefixValue?.value || '';
                return phoneCountryPrefixes.find((prefix) => prefix.iso2 === iso2)
                    || phoneCountryPrefixes.find((prefix) => prefix.dialCode === dialCode)
                    || null;
            };

            const setSelectedPhonePrefix = (prefix) => {
                if (!prefix || !phonePrefixValue || !phoneCountryIso2) {
                    return;
                }
                phonePrefixValue.value = prefix.dialCode;
                phoneCountryIso2.value = prefix.iso2;
                phonePrefixLabel.textContent = `${prefix.iso2} ${prefix.dialCode}`;
                phonePrefixToggle.title = `${prefix.localizedCountryName || prefix.countryName} ${prefix.dialCode}`;
                if (phonePrefixFlag) {
                    phonePrefixFlag.src = prefix.flagPath;
                    phonePrefixFlag.hidden = false;
                }
                renderPhonePrefixOptions(phonePrefixSearch?.value || '');
            };

            const closePhonePrefixPanel = () => {
                phonePrefixPanel?.classList.add('hidden');
                phonePrefixToggle?.setAttribute('aria-expanded', 'false');
            };

            const openPhonePrefixPanel = () => {
                phonePrefixPanel?.classList.remove('hidden');
                phonePrefixToggle?.setAttribute('aria-expanded', 'true');
                phonePrefixSearch?.focus();
                phonePrefixSearch?.select();
            };

            const renderPhonePrefixOptions = (searchTerm = '') => {
                if (!phonePrefixOptions) {
                    return;
                }
                const selectedIso2 = phoneCountryIso2?.value || '';
                const normalizedSearch = searchTerm.trim().toLowerCase();
                const filtered = phoneCountryPrefixes
                    .filter((prefix) => {
                        const haystack = [
                            prefix.iso2,
                            prefix.dialCode,
                            prefix.countryName,
                            prefix.localizedCountryName
                        ].filter(Boolean).join(' ').toLowerCase();
                        return haystack.includes(normalizedSearch);
                    })
                    .slice(0, 80);

                phonePrefixOptions.innerHTML = '';
                if (filtered.length === 0) {
                    const empty = document.createElement('div');
                    empty.className = 'px-3 py-2 text-sm text-slate-500';
                    empty.textContent = 'Nessun prefisso trovato';
                    phonePrefixOptions.append(empty);
                    return;
                }

                filtered.forEach((prefix) => {
                    const option = document.createElement('button');
                    option.type = 'button';
                    option.className = 'flex w-full items-center gap-3 px-3 py-2 text-left text-sm text-slate-700 hover:bg-indigo-50';
                    option.innerHTML = `
                        <img alt="" class="h-4 w-6 shrink-0 rounded-sm object-cover ring-1 ring-slate-200" src="${prefix.flagPath}" />
                        <span class="flex-1">${prefix.localizedCountryName || prefix.countryName}</span>
                        <span class="shrink-0 text-slate-500">${prefix.dialCode}</span>
                    `;
                    option.addEventListener('click', () => {
                        setSelectedPhonePrefix(prefix);
                        closePhonePrefixPanel();
                        phonePrefixToggle?.focus();
                    });
                    phonePrefixOptions.append(option);
                });
            };

            const loadPhonePrefixes = async () => {
                phoneCountryPrefixes = await fetchJson(endpoints.phonePrefixes);
                if (phoneCountryPrefixes.length === 0) {
                    return;
                }
                const currentIso2 = phoneCountryIso2?.value || '';
                const currentDialCode = phonePrefixValue?.value || '+39';
                const selected = phoneCountryPrefixes.find((prefix) => prefix.iso2 === currentIso2)
                    || phoneCountryPrefixes.find((prefix) => prefix.dialCode === currentDialCode && prefix.iso2 === 'IT')
                    || phoneCountryPrefixes.find((prefix) => prefix.dialCode === currentDialCode)
                    || phoneCountryPrefixes.find((prefix) => prefix.iso2 === 'IT')
                    || phoneCountryPrefixes[0];
                setSelectedPhonePrefix(selected);
            };

            phonePrefixToggle?.addEventListener('click', () => {
                const isOpen = phonePrefixToggle.getAttribute('aria-expanded') === 'true';
                if (isOpen) {
                    closePhonePrefixPanel();
                } else {
                    openPhonePrefixPanel();
                }
            });

            phonePrefixSearch?.addEventListener('input', () => {
                renderPhonePrefixOptions(phonePrefixSearch.value);
            });

            phonePrefixSearch?.addEventListener('keydown', (event) => {
                if (event.key === 'Escape') {
                    closePhonePrefixPanel();
                    phonePrefixToggle?.focus();
                    return;
                }
                if (event.key === 'Enter') {
                    event.preventDefault();
                    phonePrefixOptions?.querySelector('button')?.click();
                }
            });

            document.addEventListener('click', (event) => {
                if (phonePrefixCombobox && !phonePrefixCombobox.contains(event.target)) {
                    closePhonePrefixPanel();
                }
            });

            loadPhonePrefixes();
        })();
    </script>
}
