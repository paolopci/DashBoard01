@model DashboardOrders.Models.UserProfileViewModel
@{
    ViewData["Title"] = "Edit Profilo";
}

<div class="mb-8">
    <h2 class="text-2xl font-bold text-slate-800">Edit Profilo</h2>
    <p class="mt-1 text-slate-500">Nome, cognome ed email restano invariati.</p>
</div>

<form method="post" asp-controller="Account" asp-action="EditProfile" class="overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm">
    @Html.AntiForgeryToken()
    <input asp-for="FirstName" type="hidden" />
    <input asp-for="LastName" type="hidden" />
    <input asp-for="Email" type="hidden" />

    <div class="border-b border-slate-100 px-6 py-5">
        <h3 class="text-lg font-semibold text-slate-800">@Model.FirstName @Model.LastName</h3>
        <p class="text-sm text-slate-500">@Model.Email</p>
    </div>

    <div asp-validation-summary="ModelOnly" class="px-6 pt-5 text-sm font-semibold text-rose-600"></div>

    <div class="grid grid-cols-1 gap-5 px-6 py-6 md:grid-cols-2">
        <div>
            <label asp-for="DateOfBirth" class="mb-2 block text-sm font-semibold text-slate-700">Data di nascita</label>
            <input asp-for="DateOfBirth" type="date" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" />
            <span asp-validation-for="DateOfBirth" class="mt-1 block text-xs font-semibold text-rose-600"></span>
        </div>
        <div>
            <label asp-for="City" class="mb-2 block text-sm font-semibold text-slate-700">Citta</label>
            <input asp-for="City" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" />
            <span asp-validation-for="City" class="mt-1 block text-xs font-semibold text-rose-600"></span>
        </div>
        <div>
            <label asp-for="Country" class="mb-2 block text-sm font-semibold text-slate-700">Paese</label>
            <input asp-for="Country" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" />
            <span asp-validation-for="Country" class="mt-1 block text-xs font-semibold text-rose-600"></span>
        </div>
        <div>
            <label asp-for="FiscalCode" class="mb-2 block text-sm font-semibold text-slate-700">Codice fiscale</label>
            <input asp-for="FiscalCode" maxlength="16" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm uppercase text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" />
            <span asp-validation-for="FiscalCode" class="mt-1 block text-xs font-semibold text-rose-600"></span>
        </div>
    </div>

    <div class="flex flex-col gap-3 border-t border-slate-100 px-6 py-5 sm:flex-row sm:justify-end">
        <a asp-controller="Account" asp-action="Profile" class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-600 transition-colors hover:border-slate-300">
            Annulla
        </a>
        <button type="submit" class="inline-flex items-center justify-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm shadow-indigo-600/20 transition-colors hover:bg-indigo-700">
            Salva profilo
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
