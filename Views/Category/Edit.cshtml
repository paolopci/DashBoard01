@using DashboardOrders.Models
@model Category
@{
    ViewData["Title"] = "Modifica Categoria";
}

<div class="mb-8">
    <h2 class="text-2xl font-bold text-slate-800">Modifica Categoria</h2>
    <p class="text-slate-500 mt-1">Aggiorna le informazioni della categoria.</p>
</div>

<div class="max-w-2xl">
    <div class="overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm">
        <div class="px-6 py-5 border-b border-slate-100">
            <h3 class="text-lg font-semibold text-slate-800">Modifica Dati</h3>
        </div>
        <div class="p-6">
            <form method="post" asp-action="Edit">
                <input type="hidden" asp-for="Code" value="@Model.Code" />
                <input type="hidden" asp-for="Name" value="@Model.Name" />

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="md:col-span-2">
                        <label for="Description" class="block text-sm font-medium text-slate-700 mb-2">
                            Descrizione
                        </label>
                        <textarea name="Description" id="Description" rows="4"
                                  class="rounded-lg border border-slate-200 px-4 py-2.5 text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 w-full resize-none"
                                  placeholder="Descrivi la categoria...">@Model.Description</textarea>
                    </div>
                </div>

                <div class="flex items-center gap-3 mt-8 pt-6 border-t border-slate-100">
                    <button type="submit" class="inline-flex items-center rounded-xl bg-indigo-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 transition-colors">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                        Salva Modifiche
                    </button>
                    <a asp-action="Index" class="inline-flex items-center rounded-xl border border-slate-200 bg-white px-6 py-2.5 text-sm font-semibold text-slate-600 shadow-sm hover:border-indigo-200 hover:text-indigo-600 transition-colors">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                        Annulla
                    </a>
                </div>
            </form>

            <div class="mt-8 p-6 rounded-xl border border-rose-200 bg-rose-50">
                <h4 class="text-rose-800 font-semibold mb-2">Pericolo</h4>
                <p class="text-rose-700 text-sm mb-4">L'eliminazione della categoria non può essere annullata. Assicurati che non ci siano prodotti associati prima di procedere.</p>
                <a asp-action="Delete" asp-route-code="@Model.Code" class="inline-flex items-center rounded-xl border border-rose-300 bg-white px-4 py-2 text-sm font-semibold text-rose-600 shadow-sm hover:bg-rose-100 transition-colors">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                    </svg>
                    Elimina Categoria
                </a>
            </div>
        </div>
    </div>
</div>
