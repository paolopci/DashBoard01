@using DashboardOrders.Models
@model Category
@{
    ViewData["Title"] = "Nuova Categoria";
}

<div class="mb-8">
    <h2 class="text-2xl font-bold text-slate-800">Nuova Categoria</h2>
    <p class="text-slate-500 mt-1">Crea una nuova categoria per i prodotti.</p>
</div>

<div class="max-w-2xl">
    <div class="overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm">
        <div class="px-6 py-5 border-b border-slate-100">
            <h3 class="text-lg font-semibold text-slate-800">Inserisci i Dati</h3>
        </div>
        <div class="p-6">
            <form method="post" asp-action="Create">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label for="Code" class="block text-sm font-medium text-slate-700 mb-2">
                            Codice <span class="text-rose-500">*</span>
                        </label>
                        <input type="text" name="Code" id="Code" required maxlength="50"
                               class="rounded-lg border border-slate-200 px-4 py-2.5 text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 w-full"
                               placeholder="Es: ELETTRONICA" />
                    </div>
                    <div class="md:col-span-2">
                        <label for="Name" class="block text-sm font-medium text-slate-700 mb-2">
                            Nome Categoria <span class="text-rose-500">*</span>
                        </label>
                        <input type="text" name="Name" id="Name" required
                               class="rounded-lg border border-slate-200 px-4 py-2.5 text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 w-full"
                               placeholder="Es: Elettronica" />
                    </div>

                    <div class="md:col-span-2">
                        <label for="Description" class="block text-sm font-medium text-slate-700 mb-2">
                            Descrizione
                        </label>
                        <textarea name="Description" id="Description" rows="4"
                                  class="rounded-lg border border-slate-200 px-4 py-2.5 text-slate-700 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200 w-full resize-none"
                                  placeholder="Descrivi la categoria..."></textarea>
                    </div>
                </div>

                <div class="flex items-center gap-3 mt-8 pt-6 border-t border-slate-100">
                    <button type="submit" class="inline-flex items-center rounded-xl bg-indigo-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 transition-colors">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                        Crea Categoria
                    </button>
                    <a asp-action="Index" class="inline-flex items-center rounded-xl border border-slate-200 bg-white px-6 py-2.5 text-sm font-semibold text-slate-600 shadow-sm hover:border-indigo-200 hover:text-indigo-600 transition-colors">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                        Annulla
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="mt-6 p-4 rounded-xl bg-amber-50 border border-amber-200">
        <div class="flex items-start">
            <svg class="w-5 h-5 text-amber-600 mt-0.5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
            <div class="text-sm text-amber-800">
                <p class="font-semibold mb-1">Nota</p>
                <p>Assicurati che il codice della categoria sia univoco per evitare conflitti con i prodotti esistenti.</p>
            </div>
        </div>
    </div>
</div>
